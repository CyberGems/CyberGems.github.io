---
import '../styles/global.css';
import { ui, type Lang } from '../data/ui';
import NavIcon from '../components/NavIcon.astro';
import { apps } from '../data/apps';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Current page path including locale, e.g. "/", "/es/", "/apps/cybersnap", "/es/apps/cybersnap" */
  path: string;
  /** Absolute OG image URL path, e.g. "/og.png" or "/og/cybersnap.png" */
  ogImage?: string;
  /** Optional JSON-LD object to inject */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** If true, emits <meta name="robots" content="noindex, nofollow"> */
  noIndex?: boolean;
}

const { title, description, lang, path, ogImage, jsonLd, noIndex } = Astro.props;
const t = ui[lang];
const switchHref = lang === 'en' ? (path === '/' ? '/es/' : `/es${path}`) : path.replace(/^\/es/, '') || '/';
const homeHref = lang === 'en' ? '/' : '/es/';
// Normalize canonical: strip trailing slash except root, ensure leading slash
const normalizedPath = (() => {
  let p = path.startsWith('/') ? path : `/${path}`;
  if (p.length > 1 && p.endsWith('/')) p = p.slice(0, -1);
  // Special case: keep "/es" as "/es" (canonical without trailing slash is fine)
  return p || '/';
})();
const canonical = new URL(normalizedPath === '/' ? '/' : `${normalizedPath}/`, Astro.site);
// hreflang alternates — both with trailing slash like canonical
const canonicalHref = canonical.href;
const enPath = normalizedPath.replace(/^\/es/, '') || '/';
const enHref = lang === 'en' ? canonicalHref : new URL(enPath === '/' ? '/' : `${enPath}/`, Astro.site).href;
const esHref = lang === 'es' ? canonicalHref : new URL(normalizedPath === '/' ? '/es/' : `/es${normalizedPath}/`, Astro.site).href;
const isActive = (href: string) => { const target = href.replace(/\/$/, '') || '/'; const current = path.replace(/\/$/, '') || '/'; return current === target; };
const navLinkClass = (href: string) =>
  'inline-flex items-center gap-1.5 text-sm transition-colors ' + (isActive(href) ? 'nav-link-active' : 'text-[#9a9aa5] hover:text-white');
const mobileLinkClass = (href: string) =>
  'inline-flex items-center gap-2 rounded-lg px-3 py-2.5 text-sm transition-colors ' + (isActive(href) ? 'bg-white/10 text-white font-semibold' : 'text-[#c9c9d1] hover:bg-white/5 hover:text-white');
const donateHref = lang === 'en' ? '/donate' : '/es/donate';
const donateActive = isActive(donateHref);
const appsActive = /^\/(?:es\/)?apps\//.test(path);
const xDefaultHref = new URL('/', Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : new URL('/og.png', Astro.site).href;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const ogLocaleAlt = lang === 'es' ? 'en_US' : 'es_ES';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/branding/cybergems-favicon.png" sizes="512x512" />
    <link rel="preconnect" href="https://api.github.com" />
    <link rel="canonical" href={canonicalHref} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="es" href={esHref} />
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:site_name" content="CyberGems" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlt} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <meta name="theme-color" content="#0d0f17" />
    <title>{title}</title>
    {import.meta.env.PROD && (
      <script is:inline>
        (() => {
          const privacySignal = navigator.doNotTrack === '1'
            || window.doNotTrack === '1'
            || navigator.globalPrivacyControl === true;
          if (privacySignal) return;
          const script = document.createElement('script');
          script.defer = true;
          script.dataset.websiteId = 'c6d75024-3ca1-484a-bc54-cf1fc24ad6e0';
          script.dataset.doNotTrack = 'true';
          script.dataset.domains = 'cybergems.org,www.cybergems.org';
          script.src = 'https://cloud.umami.is/script.js';
          document.head.appendChild(script);
        })();
      </script>
    )}
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-white focus:text-[#0d0f17] focus:font-bold">{t.skipToContent}</a>
    <a
      href="https://github.com/CyberGems"
      target="_blank"
      rel="noopener noreferrer"
      class="github-corner"
      aria-label={lang === 'en' ? 'CyberGems on GitHub' : 'CyberGems en GitHub'}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="currentColor" d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.73.084-.73 1.205.084 1.838 1.237 1.838 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.4 3-.405 1.02.005 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
      </svg>
      <span class="sr-only">{t.navGitHub}</span>
    </a>
    <header class="sticky top-0 z-50 backdrop-blur-md bg-[#0d0f17]/80 border-b border-white/5">
      <nav aria-label="Primary" class="max-w-6xl mx-auto px-5 lg:pr-24 h-16 flex items-center justify-between">
        <a href={homeHref} class="inline-flex min-w-0 shrink items-center" aria-label="CyberGems">
          <img src="/branding/cybergems-header.svg" alt="CyberGems" width="192" height="32" class="h-6 w-auto sm:h-8" />
        </a>
        <div class="flex items-center gap-2 sm:gap-5">
          <div class="relative hidden sm:inline-flex items-center gap-0.5" data-apps-dropdown>
            <a href={`${homeHref}#apps`} class:list={['inline-flex items-center gap-1.5 text-sm transition-colors hover:text-white', appsActive ? 'nav-link-active' : 'text-[#9a9aa5]']}><NavIcon name="apps" /><span>{t.navApps}</span></a>
            <button type="button" class="rounded p-1 text-[#9a9aa5] hover:bg-white/5 hover:text-white focus-visible:outline-2 focus-visible:outline-[#00f2ff]" aria-label={lang === 'en' ? 'Show app shortcuts' : 'Mostrar accesos a las apps'} aria-controls="desktop-apps-menu" aria-expanded="false" data-apps-toggle>
              <svg class="h-3.5 w-3.5 transition-transform" data-apps-chevron viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m3 6 5 5 5-5" /></svg>
            </button>
            <div id="desktop-apps-menu" class="hidden absolute left-1/2 top-full z-50 mt-3 w-[440px] max-w-[calc(100vw-2rem)] -translate-x-1/2 rounded-2xl border border-white/10 bg-[#151a24] p-3 shadow-[0_22px_60px_#0009]" data-apps-panel>
              <p class="px-2 pb-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#8e98a8]">{lang === 'en' ? 'Explore the apps' : 'Explora las apps'}</p>
              <div class="grid grid-cols-2 gap-1">
                {apps.map((app) => {
                  const href = `${lang === 'en' ? '' : '/es'}/apps/${app.slug}`;
                  return <a href={href} class:list={['flex min-w-0 items-center gap-2.5 rounded-lg px-2 py-2 text-sm transition-colors hover:bg-white/7 hover:text-white focus-visible:bg-white/7 focus-visible:outline-2 focus-visible:outline-[#00f2ff]', isActive(href) ? 'bg-white/10 font-semibold text-white' : 'text-[#c9c9d1]']} aria-current={isActive(href) ? 'page' : undefined}>
                    <img src={app.icon} alt="" width="28" height="28" class="h-7 w-7 shrink-0 object-contain" loading="lazy" />
                    <span class="truncate">{app.name}</span>
                  </a>;
                })}
              </div>
              <a href={`${homeHref}#apps`} class="mt-2 flex items-center justify-between border-t border-white/10 px-2 pt-3 text-sm font-semibold text-[#72dff5] hover:text-white">{lang === 'en' ? 'See all apps' : 'Ver todas las apps'}<span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <a href={lang === 'en' ? '/changelog' : '/es/changelog'} class={`${navLinkClass(lang === 'en' ? '/changelog' : '/es/changelog')} hidden md:inline-flex`} aria-current={isActive(lang === 'en' ? '/changelog' : '/es/changelog') ? 'page' : undefined}><NavIcon name="newspaper" /><span>{t.navChangelog}</span></a>
          <a href={lang === 'en' ? '/docs' : '/es/docs'} class={`hidden sm:inline-flex ${navLinkClass(lang === 'en' ? '/docs' : '/es/docs')}`} aria-current={isActive(lang === 'en' ? '/docs' : '/es/docs') ? 'page' : undefined}><NavIcon name="book" size={19} /><span>{t.navDocs}</span></a>
          <a href={lang === 'en' ? '/about' : '/es/about'} class={`hidden lg:inline-flex items-center gap-1.5 text-sm transition-colors ${isActive(lang === 'en' ? '/about' : '/es/about') ? 'nav-link-active' : 'text-[#9a9aa5] hover:text-white'}`} aria-current={isActive(lang === 'en' ? '/about' : '/es/about') ? 'page' : undefined}><NavIcon name="info" /><span>{t.navAbout}</span></a>
          <a href={lang === 'en' ? '/contact' : '/es/contact'} class={`hidden xl:inline-flex items-center gap-1.5 text-sm transition-colors ${isActive(lang === 'en' ? '/contact' : '/es/contact') ? 'nav-link-active' : 'text-[#9a9aa5] hover:text-white'}`} aria-current={isActive(lang === 'en' ? '/contact' : '/es/contact') ? 'page' : undefined}><NavIcon name="mail" /><span>{t.navContact}</span></a>
          <a href={donateHref} class={`hidden sm:inline-flex items-center gap-1.5 text-sm font-semibold hover:opacity-80 transition-opacity ${donateActive ? 'nav-link-active' : ''}`} aria-current={donateActive ? 'page' : undefined}><NavIcon name="heart" class="shrink-0 text-[#00f2ff]" /><span class="text-gradient">{t.navDonate}</span></a>
          <a
            href={lang === 'en' ? '/download' : '/es/download'}
            class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs sm:text-sm font-bold text-[#0d0f17] bg-[#00f2ff] hover:brightness-105 shadow-[0_0_20px_rgba(0,242,255,0.35)] hover:shadow-[0_0_25px_rgba(0,242,255,0.55)] transition-all shrink-0"
            aria-current={isActive(lang === 'en' ? '/download' : '/es/download') ? 'page' : undefined}
          >
            <NavIcon name="download" size={15} class="shrink-0" />
            <span>{t.navDownload}</span>
          </a>
          <div
            class="inline-flex items-center gap-1 rounded-full border border-white/10 p-1"
            role="group"
            aria-label={lang === 'en' ? 'Language' : 'Idioma'}
          >
            <a
              href={lang === 'en' ? path : switchHref}
              lang="en"
              aria-current={lang === 'en' ? 'page' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wide transition-colors',
                lang === 'en' ? 'bg-[#00f2ff] text-[#0d0f17]' : 'text-[#9a9aa5] hover:text-white',
              ]}
            >EN</a>
            <a
              href={lang === 'es' ? path : switchHref}
              lang="es"
              aria-current={lang === 'es' ? 'page' : undefined}
              class:list={[
                'rounded-full px-2.5 py-1 text-[11px] font-bold tracking-wide transition-colors',
                lang === 'es' ? 'bg-[#00f2ff] text-[#0d0f17]' : 'text-[#9a9aa5] hover:text-white',
              ]}
            >ES</a>
          </div>
          <button
            type="button"
            class="md:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-white/10 text-[#c9c9d1] hover:border-[#00f2ff] hover:text-white transition-colors"
            data-mobile-menu-toggle
            aria-controls="mobile-menu"
            aria-expanded="false"
            aria-label={lang === 'en' ? 'Open navigation' : 'Abrir navegación'}
            data-open-label={lang === 'en' ? 'Open navigation' : 'Abrir navegación'}
            data-close-label={lang === 'en' ? 'Close navigation' : 'Cerrar navegación'}
          >
            <span data-mobile-menu-icon aria-hidden="true">☰</span>
          </button>
        </div>
      </nav>
      <div id="mobile-menu" class="hidden max-h-[calc(100dvh-4rem)] overflow-y-auto md:hidden border-t border-white/5 bg-[#0d0f17]/95">
        <nav aria-label={lang === 'en' ? 'Mobile navigation' : 'Navegación móvil'} class="max-w-6xl mx-auto px-5 py-3 grid grid-cols-2 gap-2">
          <div class="flex min-w-0 items-center rounded-lg text-sm text-[#c9c9d1] hover:bg-white/5">
            <a href={`${homeHref}#apps`} class="inline-flex min-w-0 flex-1 items-center gap-2 rounded-l-lg px-3 py-2.5 hover:text-white" data-mobile-menu-link><NavIcon name="apps" /><span>{t.navApps}</span></a>
            <button type="button" class="shrink-0 rounded-r-lg px-2 py-2.5 hover:text-white focus-visible:outline-2 focus-visible:outline-[#00f2ff]" aria-label={lang === 'en' ? 'Show app shortcuts' : 'Mostrar accesos a las apps'} aria-controls="mobile-apps-list" aria-expanded="false" data-mobile-apps-toggle>
              <svg class="h-4 w-4 transition-transform" data-mobile-apps-chevron viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m3 6 5 5 5-5" /></svg>
            </button>
          </div>
          <a href={lang === 'en' ? '/download' : '/es/download'} class={mobileLinkClass(lang === 'en' ? '/download' : '/es/download')} aria-current={isActive(lang === 'en' ? '/download' : '/es/download') ? 'page' : undefined} data-mobile-menu-link><NavIcon name="download" /><span>{t.navDownload}</span></a>
          <div id="mobile-apps-list" class="hidden col-span-2 grid grid-cols-2 gap-1 rounded-xl border border-white/10 bg-white/[0.03] p-2" data-mobile-apps-list>
            {apps.map((app) => {
              const href = `${lang === 'en' ? '' : '/es'}/apps/${app.slug}`;
              return <a href={href} class:list={['flex min-w-0 items-center gap-2 rounded-lg px-2 py-2 text-xs transition-colors hover:bg-white/7 hover:text-white', isActive(href) ? 'bg-white/10 font-semibold text-white' : 'text-[#c9c9d1]']} aria-current={isActive(href) ? 'page' : undefined} data-mobile-menu-link>
                <img src={app.icon} alt="" width="24" height="24" class="h-6 w-6 shrink-0 object-contain" loading="lazy" />
                <span class="truncate">{app.name}</span>
              </a>;
            })}
          </div>
          <a href={lang === 'en' ? '/changelog' : '/es/changelog'} class={mobileLinkClass(lang === 'en' ? '/changelog' : '/es/changelog')} aria-current={isActive(lang === 'en' ? '/changelog' : '/es/changelog') ? 'page' : undefined} data-mobile-menu-link><NavIcon name="newspaper" /><span>{t.navChangelog}</span></a>
          <a href={lang === 'en' ? '/docs' : '/es/docs'} class={mobileLinkClass(lang === 'en' ? '/docs' : '/es/docs')} aria-current={isActive(lang === 'en' ? '/docs' : '/es/docs') ? 'page' : undefined} data-mobile-menu-link><NavIcon name="book" size={19} /><span>{t.navDocs}</span></a>
          <a href={lang === 'en' ? '/about' : '/es/about'} class={mobileLinkClass(lang === 'en' ? '/about' : '/es/about')} aria-current={isActive(lang === 'en' ? '/about' : '/es/about') ? 'page' : undefined} data-mobile-menu-link><NavIcon name="info" /><span>{t.navAbout}</span></a>
          <a href={lang === 'en' ? '/faq' : '/es/faq'} class={mobileLinkClass(lang === 'en' ? '/faq' : '/es/faq')} aria-current={isActive(lang === 'en' ? '/faq' : '/es/faq') ? 'page' : undefined} data-mobile-menu-link><NavIcon name="info" /><span>{t.navFaq}</span></a>
          <a href={lang === 'en' ? '/contact' : '/es/contact'} class={mobileLinkClass(lang === 'en' ? '/contact' : '/es/contact')} aria-current={isActive(lang === 'en' ? '/contact' : '/es/contact') ? 'page' : undefined} data-mobile-menu-link><NavIcon name="mail" /><span>{t.navContact}</span></a>
          <a href="https://github.com/CyberGems" target="_blank" rel="noopener noreferrer" class="rounded-lg px-3 py-2.5 text-sm text-[#c9c9d1] hover:bg-white/5 hover:text-white" data-mobile-menu-link>{t.navGitHub} ↗</a>
          <a href={donateHref} class={`col-span-2 ${mobileLinkClass(donateHref)}`} aria-current={donateActive ? 'page' : undefined} data-mobile-menu-link><NavIcon name="heart" class="shrink-0 text-[#00f2ff]" /><span class="text-gradient">{t.navDonate}</span></a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-white/5 mt-20">
      <div class="max-w-6xl mx-auto px-5 py-12 grid gap-10 md:grid-cols-[1.35fr_1fr_1fr_1fr]">
        <div class="grid grid-cols-[auto_1fr] items-center gap-6">
          <img src="/branding/cybergems-footer.svg" alt="CyberGems" width="128" height="128" class="h-[4.5rem] w-[4.5rem]" loading="lazy" decoding="async" />
          <div>
            <p class="text-sm text-[#9a9aa5] leading-relaxed">{t.footerTagline}</p>
            <p class="mt-4 text-sm text-[#9a9aa5] leading-relaxed">{t.madeBy}</p>
          </div>
        </div>
        <nav aria-label="Explore">
          <p class="text-xs font-bold uppercase tracking-wider text-white/60">{t.footerExplore}</p>
          <ul class="mt-3 space-y-2 text-sm text-[#9a9aa5]">
            <li><a href={`${homeHref}#apps`} class="hover:text-white transition-colors">{t.navApps}</a></li>
            <li><a href={lang === 'en' ? '/download' : '/es/download'} class="hover:text-white transition-colors">{t.navDownload}</a></li>
            <li><a href={lang === 'en' ? '/about' : '/es/about'} class="hover:text-white transition-colors">{t.navAbout}</a></li>
            <li><a href={lang === 'en' ? '/contact' : '/es/contact'} class="hover:text-white transition-colors">{t.navContact}</a></li>
            <li><a href={lang === 'en' ? '/donate' : '/es/donate'} class="hover:text-white transition-colors">♥ {t.navDonate}</a></li>
          </ul>
        </nav>
        <nav aria-label="Resources">
          <p class="text-xs font-bold uppercase tracking-wider text-white/60">{t.footerResources}</p>
          <ul class="mt-3 space-y-2 text-sm text-[#9a9aa5]">
            <li><a href={lang === 'en' ? '/docs' : '/es/docs'} class="hover:text-white transition-colors">{t.navDocs}</a></li>
            <li><a href={lang === 'en' ? '/changelog' : '/es/changelog'} class="hover:text-white transition-colors">{t.navChangelog}</a></li>
            <li><a href={lang === 'en' ? '/faq' : '/es/faq'} class="hover:text-white transition-colors">{t.navFaq}</a></li>
            <li><a href="https://github.com/CyberGems" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{t.navGitHub} ↗</a></li>
          </ul>
        </nav>
        <nav aria-label="Project">
          <p class="text-xs font-bold uppercase tracking-wider text-white/60">{t.footerProject}</p>
          <ul class="mt-3 space-y-2 text-sm text-[#9a9aa5]">
            <li><a href={lang === 'en' ? '/privacy' : '/es/privacy'} class="hover:text-white transition-colors">{t.navPrivacy}</a></li>
            <li><a href="https://www.gnu.org/licenses/gpl-3.0.html" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">GPLv3 ↗</a></li>
            <li><a href="https://github.com/CyberGems/CyberGems" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">github.com/CyberGems ↗</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const dropdown = document.querySelector('[data-apps-dropdown]');
        const toggle = dropdown?.querySelector('[data-apps-toggle]');
        const panel = dropdown?.querySelector('[data-apps-panel]');
        if (!dropdown || !toggle || !panel) return;
        const hoverEnabled = window.matchMedia('(hover: hover) and (pointer: fine)');
        let openTimer;
        let closeTimer;
        const clearTimers = () => {
          window.clearTimeout(openTimer);
          window.clearTimeout(closeTimer);
        };
        const setOpen = (open) => {
          panel.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.querySelector('[data-apps-chevron]')?.classList.toggle('rotate-180', open);
        };
        dropdown.addEventListener('pointerenter', (event) => {
          if (!hoverEnabled.matches || event.pointerType !== 'mouse') return;
          window.clearTimeout(closeTimer);
          openTimer = window.setTimeout(() => setOpen(true), 180);
        });
        dropdown.addEventListener('pointerleave', (event) => {
          if (!hoverEnabled.matches || event.pointerType !== 'mouse') return;
          window.clearTimeout(openTimer);
          closeTimer = window.setTimeout(() => setOpen(false), 260);
        });
        toggle.addEventListener('click', (event) => {
          clearTimers();
          setOpen(hoverEnabled.matches && event.detail > 0 ? true : toggle.getAttribute('aria-expanded') !== 'true');
        });
        dropdown.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            clearTimers();
            setOpen(false);
            toggle.focus();
          }
        });
        dropdown.addEventListener('focusout', (event) => {
          if (!dropdown.contains(event.relatedTarget)) {
            clearTimers();
            setOpen(false);
          }
        });
        document.addEventListener('pointerdown', (event) => {
          if (!dropdown.contains(event.target)) {
            clearTimers();
            setOpen(false);
          }
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const toggle = document.querySelector('[data-mobile-menu-toggle]');
        const menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;
        const icon = toggle.querySelector('[data-mobile-menu-icon]');
        const appsToggle = menu.querySelector('[data-mobile-apps-toggle]');
        const appsList = menu.querySelector('[data-mobile-apps-list]');
        const setAppsOpen = (open) => {
          if (!appsToggle || !appsList) return;
          appsList.classList.toggle('hidden', !open);
          appsToggle.setAttribute('aria-expanded', String(open));
          appsToggle.querySelector('[data-mobile-apps-chevron]')?.classList.toggle('rotate-180', open);
        };
        const setOpen = (open) => {
          menu.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', toggle.getAttribute(open ? 'data-close-label' : 'data-open-label') || 'Menu');
          if (icon) icon.textContent = open ? '×' : '☰';
          if (!open) setAppsOpen(false);
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        appsToggle?.addEventListener('click', () => setAppsOpen(appsToggle.getAttribute('aria-expanded') !== 'true'));
        menu.querySelectorAll('[data-mobile-menu-link]').forEach((link) => link.addEventListener('click', () => setOpen(false)));
        menu.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape') return;
          if (appsToggle?.getAttribute('aria-expanded') === 'true') {
            setAppsOpen(false);
            appsToggle.focus();
          } else {
            setOpen(false);
            toggle.focus();
          }
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 768) setOpen(false);
        });
      })();
    </script>
    <script is:inline>
      (() => {
        const trackDownloadStart = (link) => {
          const href = link.getAttribute('href') || '';
          if (!/\.(?:exe|zip)(?:[?#]|$)/i.test(href)) return;
          if (!window.umami || typeof window.umami.track !== 'function') return;
          window.umami.track('download_start', {
            app: link.getAttribute('data-umami-event-app') || 'unknown',
            format: link.getAttribute('data-umami-event-format') || 'unknown',
            source: link.getAttribute('data-umami-event-source') || 'unknown',
          });
        };

        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;
          const link = target.closest('[data-download-start]');
          if (link) trackDownloadStart(link);
        }, true);
      })();
    </script>
  </body>
</html>
