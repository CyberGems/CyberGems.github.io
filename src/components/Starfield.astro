---
// Seeded positions keep the sky stable across builds and available without JavaScript.
let seed = 1427;
const random = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const layers = [
  { count: 100, depth: 0.25, radius: 0.65, opacity: 0.36 },
  { count: 55, depth: 0.6, radius: 0.95, opacity: 0.52 },
  { count: 24, depth: 1, radius: 1.35, opacity: 0.72 },
].map((layer, index) => ({
  ...layer,
  duration: 7 + index * 2,
  stars: Array.from({ length: layer.count }, (_, starIndex) => ({
    x: (random() * 1440).toFixed(2),
    y: (random() * 840).toFixed(2),
    radius: (layer.radius * (0.65 + random() * 0.7)).toFixed(2),
    opacity: (layer.opacity * (0.55 + random() * 0.45)).toFixed(2),
    twinkle: starIndex % 5 === 0,
    sparkle: index === 2 && starIndex % 6 === 0,
  })),
}));
---

<div class="hero-starfield absolute inset-0 overflow-hidden pointer-events-none" data-starfield aria-hidden="true">
  {layers.map((layer) => (
    <div class="starfield-layer" style={`--depth: ${layer.depth}; --twinkle-duration: ${layer.duration}s; --twinkle-delay: -${layer.depth * 5}s;`}>
      <svg class="starfield-sky" viewBox="0 0 1440 840" preserveAspectRatio="xMidYMid slice" focusable="false">
        <g>
          {layer.stars.filter((star) => !star.twinkle).map((star) => (
            <circle cx={star.x} cy={star.y} r={star.radius} opacity={star.opacity} />
          ))}
        </g>
        <g class="starfield-twinkle">
          {layer.stars.filter((star) => star.twinkle).map((star) => (
            <circle cx={star.x} cy={star.y} r={star.radius} opacity={star.opacity} />
          ))}
        </g>
        {layer.stars.filter((star) => star.sparkle).map((star) => (
          <path d="M-3 0H3M0-3V3" transform={`translate(${star.x} ${star.y})`} opacity={star.opacity} class="starfield-sparkle" />
        ))}
      </svg>
      <svg class="starfield-highlight" viewBox="0 0 1440 840" preserveAspectRatio="xMidYMid slice" focusable="false">
        {layer.stars.map((star) => <circle cx={star.x} cy={star.y} r={Number(star.radius) + 0.25} />)}
      </svg>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-starfield]').forEach((field) => {
    const hero = field.closest<HTMLElement>('[data-space-hero]');
    if (!hero) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    let inView = false;
    let frame = 0;
    let pointerX = 0;
    let pointerY = 0;

    const resetPointer = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      field.dataset.pointer = 'false';
      field.style.setProperty('--space-x', '0px');
      field.style.setProperty('--space-y', '0px');
    };
    const syncActivity = () => {
      const active = inView && !document.hidden && !reducedMotion.matches;
      field.dataset.active = String(active);
      if (!active || !finePointer.matches) resetPointer();
    };
    const updatePointer = () => {
      frame = 0;
      const bounds = hero.getBoundingClientRect();
      const x = Math.max(0, Math.min(bounds.width, pointerX - bounds.left));
      const y = Math.max(0, Math.min(bounds.height, pointerY - bounds.top));
      field.style.setProperty('--space-x', `${(0.5 - x / bounds.width) * 24}px`);
      field.style.setProperty('--space-y', `${(0.5 - y / bounds.height) * 18}px`);
      // Layers extend 24px past the hero, so the light follows the local pointer.
      field.style.setProperty('--pointer-x', `${x + 24}px`);
      field.style.setProperty('--pointer-y', `${y + 24}px`);
      field.dataset.pointer = 'true';
    };
    hero.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || !finePointer.matches || field.dataset.active !== 'true') return;
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = requestAnimationFrame(updatePointer);
    }, { passive: true });
    hero.addEventListener('pointerleave', resetPointer);
    hero.addEventListener('pointercancel', resetPointer);
    const observer = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      syncActivity();
    });
    observer.observe(hero);
    document.addEventListener('visibilitychange', syncActivity);
    reducedMotion.addEventListener('change', syncActivity);
    finePointer.addEventListener('change', syncActivity);
    syncActivity();
  });
</script>

<style>
  .hero-starfield {
    --space-x: 0px;
    --space-y: 0px;
    z-index: 0;
    /* Dim the sky behind the copy, with a little more detail toward the edges. */
    mask-image: radial-gradient(ellipse 65% 45% at 50% 30%, #0006, black 85%);
  }
  .starfield-layer {
    position: absolute;
    inset: -24px;
  }
  .starfield-sky, .starfield-highlight {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #edf0fa;
  }
  .starfield-sparkle { fill: none; stroke: #edf0fa; stroke-width: 0.65; }
  .starfield-highlight {
    opacity: 0;
    fill: #fff;
    mask-image: radial-gradient(circle 150px at calc(var(--pointer-x, -300px) - var(--space-x) * var(--depth)) calc(var(--pointer-y, -300px) - var(--space-y) * var(--depth)), black 0%, transparent 100%);
  }
  @media (prefers-reduced-motion: no-preference) {
    .starfield-layer {
      transform: translate(calc(var(--space-x) * var(--depth)), calc(var(--space-y) * var(--depth)));
      transition: transform 350ms ease-out;
    }
    .starfield-highlight { transition: opacity 350ms ease-out; }
    .hero-starfield:not([data-active="true"]) .starfield-layer,
    .hero-starfield:not([data-active="true"]) .starfield-highlight { transition: none; }
    [data-pointer="true"] .starfield-highlight { opacity: 0.85; }
    [data-active="true"] .starfield-twinkle {
      animation: star-twinkle var(--twinkle-duration) ease-in-out var(--twinkle-delay) infinite alternate;
    }
  }
  @keyframes star-twinkle {
    from { opacity: 0.4; }
    to { opacity: 1; }
  }
</style>
