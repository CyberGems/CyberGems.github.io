---
interface Props {
  name: 'apps' | 'newspaper' | 'book' | 'info' | 'mail' | 'heart' | 'download';
  size?: number;
  class?: string;
}

const { name, size = 17, class: className = 'shrink-0 opacity-75' } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {name === 'apps' && <>
    <rect x="3" y="3" width="7" height="7" rx="1" />
    <rect x="14" y="3" width="7" height="7" rx="1" />
    <rect x="3" y="14" width="7" height="7" rx="1" />
    <rect x="14" y="14" width="7" height="7" rx="1" />
  </>}
  {name === 'newspaper' && <>
    <path d="M4 4h16v16H4z" />
    <path d="M8 8h8M8 12h8M8 16h5" />
    <path d="M4 8h2" />
  </>}
  {name === 'book' && <>
    <path d="M3.5 5.5A2.5 2.5 0 0 1 6 3h6v17H6a2.5 2.5 0 0 0-2.5 2.5z" />
    <path d="M20.5 5.5A2.5 2.5 0 0 0 18 3h-6v17h6a2.5 2.5 0 0 1 2.5 2.5z" />
    <path d="M12 3v17" />
  </>}
  {name === 'info' && <>
    <circle cx="12" cy="12" r="9" />
    <path d="M12 11v5M12 8h.01" />
  </>}
  {name === 'mail' && <>
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="m3 7 9 6 9-6" />
  </>}
  {name === 'heart' && <path d="M20.8 8.8c0 5.4-8.8 10.2-8.8 10.2S3.2 14.2 3.2 8.8A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z" />}
  {name === 'download' && <>
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
    <path d="m7 10 5 5 5-5M12 15V3" />
  </>}
</svg>
