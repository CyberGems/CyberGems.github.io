---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../data/ui';
import pagesData from '../data/pages.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const c = (pagesData.privacy as Record<string, any>)[lang];
const path = en ? '/privacy' : '/es/privacy';
---

<BaseLayout title={c.metaTitle} description={c.metaDesc} lang={lang} path={path}>
  <div class="max-w-3xl mx-auto px-5 pt-16 pb-4">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight"><span class="text-gradient brand-glow">Privacy</span></h1>
      <p class="mt-3 text-[#9a9aa5]">{c.subtitle}</p>
    </header>
    <div class="mt-8 space-y-4 text-sm leading-relaxed">
      <section class="card p-6">
        <h2 class="font-bold text-base">🖥️ {c.appsTitle}</h2>
        <ul class="mt-2 text-[#c9c9d1] space-y-1.5">
          {c.appsItems.map((item: string) => <li>· {item}</li>)}
        </ul>
      </section>
      <section class="card p-6">
        <h2 class="font-bold text-base">🌐 {c.siteTitle}</h2>
        <ul class="mt-2 text-[#c9c9d1] space-y-1.5">
          {c.siteItems.map((item: string) => <li>· {item}</li>)}
        </ul>
      </section>
      <section class="card p-6">
        <h2 class="font-bold text-base">🔏 {c.signTitle}</h2>
        <p class="mt-2 text-[#c9c9d1]">{c.signText}</p>
      </section>
    </div>
  </div>
</BaseLayout>
