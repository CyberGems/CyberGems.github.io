---
import type { Lang } from '../data/ui';

interface Props {
  publishedAt: string;
  lang: Lang;
  label?: string;
  month?: 'short' | 'long';
}

const { publishedAt, lang, label, month = 'short' } = Astro.props;
const formattedDate = new Date(publishedAt).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
  year: 'numeric',
  month,
  day: 'numeric',
});
---

<time class="release-date" datetime={publishedAt}>
  <svg class="release-date-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="16" rx="2" />
    <path d="M16 3v4M8 3v4M3 11h18" />
  </svg>
  {label && <span class="release-date-label">{label}</span>}
  <span class="release-date-value">{formattedDate}</span>
</time>

<style>
  .release-date {
    display: inline-flex;
    max-width: 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid rgba(147, 181, 216, 0.24);
    border-radius: 0.45rem;
    background: rgba(110, 156, 202, 0.08);
    color: #c9d4e4;
    font-size: 0.75rem;
    line-height: 1.4;
    vertical-align: middle;
  }

  .release-date-icon {
    flex-shrink: 0;
    color: #8bd3df;
  }

  .release-date-label {
    font-weight: 500;
  }

  .release-date-value {
    color: #f3f6fc;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
</style>
