---
interface Props {
  lang: 'en' | 'es';
  accent: string;
  icon?: string;
  kind: 'connection-flow' | 'feed-flow' | 'launcher-flow' | 'viewer-flow' | 'tray-flow' | 'manager-flow' | 'notes-flow' | 'snap-flow' | 'paste-flow';
}

const { lang, accent, icon, kind } = Astro.props;
const wallCopy = lang === 'en' ? {
  eyebrow: 'CYBERWALL · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Your network, your call.',
  intro: 'A simple way to see what a per-app firewall does.',
  first: 'An app tries to connect',
  firstText: 'An unfamiliar program requests network access.',
  second: 'CyberWall lets you know',
  secondText: 'The connection starts blocked while you review the request.',
  third: 'You make the decision',
  thirdText: 'Choose what happens now and whether to keep that rule.',
  once: 'Allow once',
  always: 'Allow always',
  block: 'Block',
} : {
  eyebrow: 'CYBERWALL · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Tu red, tu decisión.',
  intro: 'Una forma sencilla de entender qué hace un firewall por aplicación.',
  first: 'Una app intenta conectarse',
  firstText: 'Un programa desconocido solicita acceso a la red.',
  second: 'CyberWall te avisa',
  secondText: 'La conexión empieza bloqueada mientras revisas la solicitud.',
  third: 'Tú tomas la decisión',
  thirdText: 'Elige qué hacer ahora y si quieres conservar esa regla.',
  once: 'Permitir una vez',
  always: 'Permitir siempre',
  block: 'Bloquear',
};
const feedCopy = lang === 'en' ? {
  eyebrow: 'CYBERFEEDS · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Follow more. Browse less.',
  intro: 'The updates you care about, together in one reading space.',
  first: 'Choose your sources',
  firstText: 'Add websites, YouTube channels and Reddit feeds, or import your subscriptions.',
  second: 'New stories arrive',
  secondText: 'CyberFeeds checks for updates and keeps your article library on your PC.',
  third: 'Read on your terms',
  thirdText: 'Read full articles when available, search your library and save favorites.',
  once: 'Read',
  always: 'Search',
  block: 'Star',
} : {
  eyebrow: 'CYBERFEEDS · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Sigue más. Navega menos.',
  intro: 'Las novedades que te importan, reunidas en un mismo espacio de lectura.',
  first: 'Elige tus fuentes',
  firstText: 'Añade sitios web, canales de YouTube y feeds de Reddit, o importa tus suscripciones.',
  second: 'Llegan novedades',
  secondText: 'CyberFeeds busca actualizaciones y guarda tu biblioteca de artículos en tu PC.',
  third: 'Lee a tu ritmo',
  thirdText: 'Lee artículos completos cuando estén disponibles, busca y guarda tus favoritos.',
  once: 'Leer',
  always: 'Buscar',
  block: 'Favoritos',
};
const launcherCopy = lang === 'en' ? {
  eyebrow: 'CYBERLAUNCHER · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'From thought to action.',
  intro: 'Find and open what you need without digging through menus.',
  first: 'Bring it up anywhere',
  firstText: 'Use a global shortcut or a hot corner to open your launcher.',
  second: 'Find it as you type',
  secondText: 'Type a few letters to find an app, or switch to system search for indexed files.',
  third: 'Open and move on',
  thirdText: 'Press Enter to launch, or keep your frequent tools in favorites.',
  once: 'Apps',
  always: 'Files',
  block: 'Commands',
} : {
  eyebrow: 'CYBERLAUNCHER · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'De la idea a la acción.',
  intro: 'Encuentra y abre lo que necesitas sin recorrer menús.',
  first: 'Ábrelo desde cualquier lugar',
  firstText: 'Usa un atajo global o una esquina activa para abrir el lanzador.',
  second: 'Encuéntralo al escribir',
  secondText: 'Escribe unas letras para encontrar una app o cambia a la búsqueda del sistema para hallar archivos indexados.',
  third: 'Abre y sigue adelante',
  thirdText: 'Pulsa Enter para abrirlo o guarda tus herramientas frecuentes en favoritos.',
  once: 'Apps',
  always: 'Archivos',
  block: 'Comandos',
};
const viewerCopy = lang === 'en' ? {
  eyebrow: 'CYBERVIEWER · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Open. Explore. Refine.',
  intro: 'A clear path from viewing an image to making it yours.',
  first: 'Open an image or folder',
  firstText: 'Drop it in, paste from the clipboard, or open it from Windows Explorer.',
  second: 'Explore every detail',
  secondText: 'Browse thumbnails, zoom and pan, or switch to fullscreen and slideshow.',
  third: 'Make a quick edit',
  thirdText: 'Rotate, crop, resize or adjust color, then save your result.',
  once: 'Crop',
  always: 'Rotate',
  block: 'Resize',
} : {
  eyebrow: 'CYBERVIEWER · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Abre. Explora. Ajusta.',
  intro: 'Un camino claro desde ver una imagen hasta dejarla a tu gusto.',
  first: 'Abre una imagen o carpeta',
  firstText: 'Arrástrala, pégala desde el portapapeles o ábrela desde el Explorador.',
  second: 'Explora cada detalle',
  secondText: 'Recorre miniaturas, haz zoom y paneo, o usa pantalla completa y diapositivas.',
  third: 'Haz un ajuste rápido',
  thirdText: 'Rota, recorta, redimensiona o ajusta el color y guarda el resultado.',
  once: 'Recortar',
  always: 'Rotar',
  block: 'Tamaño',
};
const trayCopy = lang === 'en' ? {
  eyebrow: 'CYBERTRAY · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Your tools, one gesture away.',
  intro: 'A shortcut shelf that stays out of sight until you need it.',
  first: 'Fill your shelf',
  firstText: 'Add apps, files, folders and links. Organize them in categories and favorites.',
  second: 'Call it up anywhere',
  secondText: 'Open CyberTray with Alt+Shift+T, a screen corner or its tray icon.',
  third: 'Get on with your work',
  thirdText: 'Search and launch a shortcut, then let the shelf get out of your way.',
  once: 'Apps',
  always: 'Files',
  block: 'Links',
} : {
  eyebrow: 'CYBERTRAY · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Tus herramientas, a un gesto.',
  intro: 'Una estantería de accesos que se oculta hasta que la necesitas.',
  first: 'Llena tu estantería',
  firstText: 'Añade apps, archivos, carpetas y enlaces. Ordénalos en categorías y favoritos.',
  second: 'Ábrela desde cualquier lugar',
  secondText: 'Invoca CyberTray con Alt+Shift+T, una esquina activa o su icono en la bandeja.',
  third: 'Sigue con tu trabajo',
  thirdText: 'Busca y abre un acceso; después, deja que la estantería vuelva a apartarse.',
  once: 'Apps',
  always: 'Archivos',
  block: 'Enlaces',
};
const managerCopy = lang === 'en' ? {
  eyebrow: 'CYBERMANAGER · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Find the slowdown. Take control.',
  intro: 'A clear path from a busy PC to an informed decision.',
  first: 'See what is happening',
  firstText: 'Check live CPU and memory history, or sort processes by their usage.',
  second: 'Find the process',
  secondText: 'Search by name, PID or path and inspect its details before acting.',
  third: 'Choose the next step',
  thirdText: 'End a frozen task, pause and resume a process, or change its priority.',
  once: 'Inspect',
  always: 'Pause',
  block: 'End task',
} : {
  eyebrow: 'CYBERMANAGER · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Encuentra la causa. Toma el control.',
  intro: 'Un camino claro desde un PC lento hasta una decisión informada.',
  first: 'Observa qué ocurre',
  firstText: 'Consulta el historial de CPU y memoria en vivo u ordena los procesos por consumo.',
  second: 'Encuentra el proceso',
  secondText: 'Busca por nombre, PID o ruta y revisa sus detalles antes de actuar.',
  third: 'Elige el siguiente paso',
  thirdText: 'Finaliza una tarea bloqueada, pausa y reanuda un proceso o cambia su prioridad.',
  once: 'Inspeccionar',
  always: 'Pausar',
  block: 'Finalizar',
};
const notesCopy = lang === 'en' ? {
  eyebrow: 'CYBERNOTES · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Catch the thought. Keep the thread.',
  intro: 'From a quick idea to a note you can find when it matters.',
  first: 'Write it down',
  firstText: 'Start a note, add formatting, lists or images, and let autosave take care of it.',
  second: 'Give it a place',
  secondText: 'Use colorful folders, favorites and tabs to keep related notes together.',
  third: 'Bring it back',
  thirdText: 'Search your notes or keep one floating above your work for easy reference.',
  once: 'Search',
  always: 'Favorites',
  block: 'Float',
} : {
  eyebrow: 'CYBERNOTES · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Atrapa la idea. Sigue el hilo.',
  intro: 'De una idea rápida a una nota que encontrarás cuando la necesites.',
  first: 'Escríbela',
  firstText: 'Crea una nota, añade formato, listas o imágenes y deja que se guarde sola.',
  second: 'Dale su lugar',
  secondText: 'Usa carpetas de colores, favoritos y pestañas para reunir notas relacionadas.',
  third: 'Vuelve a ella',
  thirdText: 'Busca entre tus notas o mantén una flotando sobre tu trabajo para consultarla.',
  once: 'Buscar',
  always: 'Favoritos',
  block: 'Flotante',
};
const snapCopy = lang === 'en' ? {
  eyebrow: 'CYBERSNAP · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'See it. Explain it. Keep it.',
  intro: 'Take a moment on screen from capture to a useful result.',
  first: 'Capture what matters',
  firstText: 'Grab an area, window or long page, or record a short MP4 or GIF.',
  second: 'Make your point clear',
  secondText: 'Add arrows, labels or blur; extract text with OCR when words matter.',
  third: 'Save or share',
  thirdText: 'Keep it in your searchable local gallery, copy it or upload when you choose.',
  once: 'Save',
  always: 'Copy',
  block: 'Upload',
} : {
  eyebrow: 'CYBERSNAP · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Captura. Explica. Conserva.',
  intro: 'Convierte un momento de pantalla en un resultado útil.',
  first: 'Captura lo importante',
  firstText: 'Toma un área, ventana o página larga, o graba un MP4 o GIF breve.',
  second: 'Haz clara tu idea',
  secondText: 'Añade flechas, texto o difuminado; extrae palabras con OCR si hace falta.',
  third: 'Guarda o comparte',
  thirdText: 'Consérvalo en tu galería local con búsqueda, cópialo o súbelo si decides hacerlo.',
  once: 'Guardar',
  always: 'Copiar',
  block: 'Subir',
};
const pasteCopy = lang === 'en' ? {
  eyebrow: 'CYBERPASTE · THE IDEA',
  note: 'ILLUSTRATION, NOT AN APP SCREENSHOT',
  title: 'Copy now. Find it later.',
  intro: 'Your clipboard can be more than the last thing you copied.',
  first: 'Keep working normally',
  firstText: 'Copy text, code, images, links or files; CyberPaste saves a local history.',
  second: 'Find the right clip',
  secondText: 'Press Ctrl+Shift+V, search your history or filter by type and source.',
  third: 'Use it again',
  thirdText: 'Paste into another app, pin it for later or organize it in a folder.',
  once: 'Paste',
  always: 'Pin',
  block: 'Organize',
} : {
  eyebrow: 'CYBERPASTE · LA IDEA',
  note: 'ILUSTRACIÓN, NO CAPTURA DE LA APP',
  title: 'Copia ahora. Encuentra después.',
  intro: 'Tu portapapeles puede guardar más que lo último que copiaste.',
  first: 'Trabaja como siempre',
  firstText: 'Copia texto, código, imágenes, enlaces o archivos; CyberPaste guarda un historial local.',
  second: 'Encuentra el clip adecuado',
  secondText: 'Pulsa Ctrl+Shift+V, busca en el historial o filtra por tipo y origen.',
  third: 'Úsalo de nuevo',
  thirdText: 'Pégalo en otra app, fíjalo para después u ordénalo en una carpeta.',
  once: 'Pegar',
  always: 'Fijar',
  block: 'Ordenar',
};
const copy = kind === 'paste-flow' ? pasteCopy : kind === 'snap-flow' ? snapCopy : kind === 'notes-flow' ? notesCopy : kind === 'manager-flow' ? managerCopy : kind === 'tray-flow' ? trayCopy : kind === 'viewer-flow' ? viewerCopy : kind === 'launcher-flow' ? launcherCopy : kind === 'feed-flow' ? feedCopy : wallCopy;
---

<div class="explainer relative w-full min-h-[550px] sm:min-h-[480px] lg:min-h-[495px] overflow-hidden p-5 sm:p-8 lg:p-10" style={`--explainer-accent: ${accent};`}>
  <div class="explainer-grid" aria-hidden="true"></div>
  <div class="relative z-10">
    <div class="flex flex-wrap items-center justify-between gap-3 text-[10px] sm:text-xs font-bold tracking-[0.18em]">
      <span class="text-[var(--explainer-accent)]">{copy.eyebrow}</span>
      <span class="text-[#8f96a7]">{copy.note}</span>
    </div>
    <div class="mt-6 text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">{copy.title}</h2>
      <p class="mt-2 text-sm sm:text-base text-[#aeb6c4]">{copy.intro}</p>
    </div>

    <ol class="mt-8 lg:mt-11 grid gap-3 sm:grid-cols-3 sm:gap-4">
      <li class="step-card relative rounded-2xl border border-white/10 p-4 sm:p-5">
        <span class="step-number">01</span>
        <div class="step-icon" aria-hidden="true">
          {kind === 'paste-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="11" y="8" width="26" height="34" rx="4"/><path d="M18 8V5h12v3M17 18h14M17 24h14M17 30h9"/></svg>
          ) : kind === 'snap-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 6H8a2 2 0 0 0-2 2v8M32 6h8a2 2 0 0 1 2 2v8M6 32v8a2 2 0 0 0 2 2h8M42 32v8a2 2 0 0 1-2 2h-8"/><rect x="15" y="15" width="18" height="18" rx="3"/><circle cx="24" cy="24" r="4"/></svg>
          ) : kind === 'notes-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 6h24l4 4v32H10zM34 6v6h6M16 18h16M16 25h16M16 32h11"/></svg>
          ) : kind === 'manager-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="7" width="38" height="34" rx="4"/><path d="M10 31h5l5-11 6 16 5-10h7M11 14h10"/></svg>
          ) : kind === 'tray-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="8" width="38" height="32" rx="4"/><path d="M5 17h38M14 25h8M27 25h8M14 32h8M27 32h8"/></svg>
          ) : kind === 'feed-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="7" width="29" height="25" rx="3"/><path d="M5 14h29M12 21h10M12 26h15M29 38h14M36 31v14"/></svg>
          ) : kind === 'viewer-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="7" width="40" height="34" rx="4"/><circle cx="15" cy="18" r="4"/><path d="m7 36 12-11 7 6 6-5 9 10"/></svg>
          ) : kind === 'launcher-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="3" y="10" width="42" height="28" rx="4"/><path d="M9 17h3M17 17h3M25 17h3M33 17h6M9 24h3M17 24h3M25 24h3M33 24h6M14 31h20"/></svg>
          ) : (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="6" y="8" width="36" height="28" rx="4"/><path d="M6 16h36M18 41h12M24 36v5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></svg>
          )}
        </div>
        <h3 class="mt-4 font-bold text-white text-base sm:text-lg leading-tight">{copy.first}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[#aeb6c4]">{copy.firstText}</p>
      </li>
      <li class="step-card relative rounded-2xl border border-white/10 p-4 sm:p-5">
        <span class="step-number">02</span>
        <div class="step-icon" aria-hidden="true">
          {icon ? <img src={icon} alt="" width="48" height="48" class="w-12 h-12 object-contain" /> : <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2"><path d="M24 4 40 10v12c0 12-16 21-16 21S8 34 8 22V10L24 4Z"/></svg>}
        </div>
        <h3 class="mt-4 font-bold text-white text-base sm:text-lg leading-tight">{copy.second}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[#aeb6c4]">{copy.secondText}</p>
      </li>
      <li class="step-card relative rounded-2xl border border-white/10 p-4 sm:p-5">
        <span class="step-number">03</span>
        <div class="step-icon" aria-hidden="true">
          {kind === 'paste-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="32" height="32" rx="5"/><path d="M16 17h16M16 24h16M16 31h9M31 28v11m-5-5h10"/></svg>
          ) : kind === 'snap-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="7" width="38" height="34" rx="4"/><path d="M11 33h26M12 25l7-7 6 6 5-5 7 7"/><path d="M34 11v12M29 18l5 5 5-5"/></svg>
          ) : kind === 'notes-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="10" width="27" height="29" rx="3"/><path d="M16 17h15M16 23h11M16 29h8M30 6v8M7 14V7h18"/></svg>
          ) : kind === 'manager-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8h24v32H12zM18 16h12M18 24h12M18 32h5"/><path d="m28 31 3 3 6-7"/></svg>
          ) : kind === 'tray-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 27v10a4 4 0 0 0 4 4h24a4 4 0 0 0 4-4V27M15 20l9 9 9-9M24 29V6"/></svg>
          ) : kind === 'feed-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M24 10c-5-4-12-4-18-2v30c6-2 13-2 18 2 5-4 12-4 18-2V8c-6-2-13-2-18 2ZM24 10v30"/><path d="M11 17h8M29 17h8M11 23h8M29 23h8"/></svg>
          ) : kind === 'viewer-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 7H8a2 2 0 0 0-2 2v9M31 7h9a2 2 0 0 1 2 2v9M6 30v9a2 2 0 0 0 2 2h9M42 30v9a2 2 0 0 1-2 2h-9"/><path d="M13 34 34 13"/></svg>
          ) : kind === 'launcher-flow' ? (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="32" height="30" rx="5"/><path d="M19 29 30 18M20 18h10v10"/></svg>
          ) : (
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 24 10 10L40 13"/><circle cx="24" cy="24" r="21"/></svg>
          )}
        </div>
        <h3 class="mt-4 font-bold text-white text-base sm:text-lg leading-tight">{copy.third}</h3>
        <p class="mt-2 text-sm leading-relaxed text-[#aeb6c4]">{copy.thirdText}</p>
        <div class="mt-4 flex flex-wrap gap-1.5 text-[10px] font-semibold">
          <span class="choice">{copy.once}</span><span class="choice">{copy.always}</span><span class="choice">{copy.block}</span>
        </div>
      </li>
    </ol>
  </div>
</div>

<style>
  .explainer {
    background: radial-gradient(ellipse 55% 70% at 50% 35%, color-mix(in srgb, var(--explainer-accent) 18%, transparent), transparent 75%), linear-gradient(120deg, #111923, #11131d 60%, #1c1a2c);
  }
  .explainer-grid {
    position: absolute;
    inset: 0;
    opacity: .5;
    background-image: linear-gradient(#ffffff0a 1px, transparent 1px), linear-gradient(90deg, #ffffff0a 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, #000, transparent 90%);
  }
  .step-card { background: linear-gradient(145deg, #1d2530e8, #131722eb); box-shadow: 0 16px 45px #0003; }
  .step-number { position: absolute; top: 16px; right: 18px; color: #98a2b4; font-size: 11px; font-weight: 800; letter-spacing: .18em; }
  .step-icon { display: flex; align-items: center; justify-content: center; width: 56px; height: 56px; border: 1px solid color-mix(in srgb, var(--explainer-accent) 42%, transparent); border-radius: 16px; color: var(--explainer-accent); background: color-mix(in srgb, var(--explainer-accent) 12%, #151a24); }
  .step-icon svg { width: 30px; height: 30px; }
  .choice { padding: 5px 7px; border: 1px solid #ffffff20; border-radius: 6px; color: #cbd3dd; background: #ffffff0b; }
  @media (min-width: 640px) {
    .step-card:not(:last-child)::after { content: '→'; position: absolute; z-index: 2; top: 46%; right: -20px; color: var(--explainer-accent); font-size: 24px; font-weight: 700; }
  }
</style>
