---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Lang } from '../data/ui';
import { apps } from '../data/apps';
import { listDocs } from '../data/docs';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const homeHref = lang === 'en' ? '/' : '/es/';
const path_ = lang === 'en' ? '/docs' : '/es/docs';
const title = lang === 'en' ? 'Documentation — CyberGems' : 'Documentación — CyberGems';
const description = lang === 'en'
  ? 'Official guides for every CyberGems app — synced from GitHub wikis. Choose an app to browse docs.'
  : 'Guías oficiales de cada app CyberGems — desde las wikis de GitHub. Elige una app para ver la documentación.';

// Apps whose wiki was fetched by the prebuild hook.
const docsApps = listDocs();
const available = apps.filter((a) => docsApps.some((d) => d.appDir === a.slug));
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://cybergems.org${lang === 'es' ? '/es/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: t.docsTitle, item: `https://cybergems.org${path_}/` },
  ],
};
---

<BaseLayout title={title} description={description} lang={lang} path={path_} ogImage={lang === 'es' ? '/og/es.png' : '/og.png'} jsonLd={breadcrumbLd}>
  <div class="max-w-5xl mx-auto px-5 pt-16">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight">
        <span class="text-gradient brand-glow">{t.docsTitle}</span>
      </h1>
      <p class="mt-4 text-[#9a9aa5]">{t.docsSubtitle}</p>
    </header>

    {available.length === 0 && (
      <div class="mt-10 rounded-xl border border-[#FFB74D]/40 bg-[#FFB74D]/10 text-[#FFD8A8] text-sm p-4 text-center">
        ⚠ {t.docsUnavailable}
      </div>
    )}

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {available.map((app) => {
        const href = lang === 'es' ? `/es/docs/${app.slug}/` : `/docs/${app.slug}/`;
        return (
          <a href={href} class="card p-6 block h-full">
            <div class="h-16 flex items-center" aria-hidden="true">
              {app.icon ? <img src={app.icon} alt="" width="56" height="56" class="h-14 w-14 object-contain" /> : <span class="text-4xl">{app.emoji}</span>}
            </div>
            <h2 class="mt-5 text-lg font-bold">{app.name}</h2>
            <p class="mt-1 text-sm text-[#9a9aa5]">{t.docsOpen} →</p>
          </a>
        );
      })}
    </div>

    <p class="mt-2 text-center"><a href={homeHref} class="text-sm text-[#9a9aa5] hover:text-white transition-colors">{t.backHome}</a></p>
  </div>
</BaseLayout>
