---
import BaseLayout from '../layouts/BaseLayout.astro';
import { apps } from '../data/apps';
import type { Lang } from '../data/ui';
import pagesData from '../data/pages.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const c = (pagesData.download as Record<string, any>)[lang];
const path = en ? '/download' : '/es/download';
const homePath = en ? '/' : '/es/';
const reqLabel = en ? 'Requirements:' : 'Requisitos:';
---

<BaseLayout title={c.metaTitle} description={c.metaDesc} lang={lang} path={path}>
  <div class="max-w-5xl mx-auto px-5 pt-16 pb-4">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight"><span class="text-gradient brand-glow">{c.pageTitle}</span></h1>
      <p class="mt-3 text-[#9a9aa5] max-w-2xl mx-auto">{c.subtitle}</p>
    </header>

    <div class="mt-8 grid gap-4 sm:grid-cols-3 text-left">
      <div class="card p-5">
        <div class="text-2xl" aria-hidden="true">📦</div>
        <h2 class="mt-2 font-bold">{c.m1Title}</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">{c.m1Text}</p>
      </div>
      <div class="card p-5">
        <div class="text-2xl" aria-hidden="true">💼</div>
        <h2 class="mt-2 font-bold">{c.m2Title}</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">{c.m2Text}</p>
      </div>
      <div class="card p-5">
        <div class="text-2xl" aria-hidden="true">⌨️</div>
        <h2 class="mt-2 font-bold">3. winget</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">
          <code class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-[#00f2ff] text-xs">winget install &lt;id&gt;</code>
          <span class="block mt-1.5">{c.m3Note}</span>
        </p>
      </div>
    </div>

    <section class="mt-8 card p-5 text-sm text-[#c9c9d1] leading-relaxed">
      <p><strong class="text-white">🪟 {reqLabel}</strong> Windows 10 / 11, 64-bit. {c.reqStack}</p>
      <p class="mt-2"><strong class="text-white">🔏 SmartScreen:</strong> {c.signText}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-bold">{c.allTitle}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {apps.map((app) => (
          <div class="card p-5 flex gap-4 items-start">
            <div class="w-11 h-11 rounded-xl flex items-center justify-center text-2xl border border-white/10 shrink-0" style={`background: radial-gradient(120% 120% at 20% 0%, ${app.accent}33 0%, transparent 60%);`} aria-hidden="true">{app.emoji}</div>
            <div class="min-w-0">
              <h3 class="font-bold">{app.name}</h3>
              <p class="text-xs text-[#9a9aa5] truncate">{app.tagline[lang]}</p>
              <div class="mt-2.5 flex flex-wrap gap-2 text-xs">
                <a href={`${homePath}apps/${app.slug}/`} class="font-semibold" style={`color: ${app.accent};`}>{c.dlLink}</a>
                <a href={`${app.repo}/releases`} target="_blank" rel="noopener noreferrer" class="text-[#9a9aa5] hover:text-white transition-colors">{c.relLink}</a>
                {app.winget && <code class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-[#00f2ff]">winget install {app.winget}</code>}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
