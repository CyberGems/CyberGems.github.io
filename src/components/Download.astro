---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavIcon from './NavIcon.astro';
import FeatureSymbol from './FeatureSymbol.astro';
import { appTask } from '../data/catalog';
import { apps } from '../data/apps';
import type { Lang } from '../data/ui';
import { fetchLatestDownloads } from '../data/releases';
import pagesData from '../data/pages.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const c = (pagesData.download as Record<string, any>)[lang];
const path = en ? '/download' : '/es/download';
const homePath = en ? '/' : '/es/';
const reqLabel = en ? 'Requirements:' : 'Requisitos:';

// Latest release data per app, resolved at build time so the buttons below
// are plain static links (no client-side GitHub API calls needed).
const { downloads, failed } = await fetchLatestDownloads();

const fmtSize = (bytes: number) =>
  bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`;

const wingetApps = apps.filter((a) => a.winget);
const hasWinget = wingetApps.length > 0;
const wingetLine = wingetApps.map((a) => `winget install ${a.winget}`).join('; ');
const compareCols = hasWinget ? c.cmpCols : c.cmpCols.slice(0, 2);
const compareRows = hasWinget ? c.cmpRows : c.cmpRows.map((row: any) => ({ ...row, v: row.v.slice(0, 2) }));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://cybergems.org${en ? '/' : '/es/'}` },
    { '@type': 'ListItem', position: 2, name: c.pageTitle, item: `https://cybergems.org${path}/` },
  ],
};
---

<BaseLayout title={c.metaTitle} description={c.metaDesc} lang={lang} path={path} jsonLd={breadcrumbLd}>
  <div class="max-w-5xl mx-auto px-5 pt-10 sm:pt-14 pb-4">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight"><span class="text-gradient brand-glow">{c.pageTitle}</span></h1>
      <p class="mt-3 text-[#9a9aa5] max-w-2xl mx-auto">{c.subtitle}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-2">
        <span class="chip">Windows 10 / 11</span>
        <span class="chip">64-bit</span>
        <span class="chip">GPLv3</span>
        <span class="chip">{en ? '100% free' : '100% gratis'}</span>
      </div>
      <a href="#install-help" class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm text-accent hover:text-white"><NavIcon name="info" />{en ? 'Need help installing?' : '¿Necesitas ayuda para instalar?'}</a>
    </header>

    {failed && (
      <div class="mt-8 rounded-xl border border-[#FFB74D]/40 bg-[#FFB74D]/10 text-[#FFD8A8] text-sm p-4 text-center">
        {'\u26A0'} {c.dataWarn}
      </div>
    )}

    <section class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xl font-bold">{c.allTitle}</h2>
        <input
          id="dl-search"
          type="search"
          placeholder={c.searchPh}
          aria-label={c.searchPh}
          class="cg-input w-full sm:w-72 bg-base-100"
        />
      </div>
      <p id="dl-count" data-label={en ? '{count} apps shown' : '{count} apps disponibles'} class="mt-3 text-sm text-[var(--text-dim)]" aria-live="polite" aria-atomic="true">{apps.length} {en ? 'apps shown' : 'apps disponibles'}</p>
      <div id="dl-grid" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {apps.map((app) => {
          const dl = downloads[app.slug];
          const inst = dl?.installer ?? null;
          const hasData = Boolean(dl?.tag);
          const appPage = `${homePath}apps/${app.slug}/`;
          const detailsAria = en ? `View ${app.name} details` : `Ver detalles de ${app.name}`;
          const task = appTask(app.slug);
          return (
            <div
              class="dl-card card group relative min-w-0 flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#12151f] hover:border-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-950/20 scroll-mt-24"
              id={app.slug}
              data-search={`${app.name} ${app.tagline[lang]} ${task.label[lang]} ${app.stack} ${app.license} ${app.winget || ''}`}
              style={`--app-accent: ${app.accent || '#00f2ff'};`}
            >
              {/* Top subtle accent glow */}
              <div
                class="pointer-events-none absolute inset-x-0 top-0 h-[2px] opacity-40 transition-opacity duration-300 group-hover:opacity-100"
                style="background: linear-gradient(90deg, transparent, var(--app-accent), transparent);"
                aria-hidden="true"
              />

              {/* Ambient background watermark icon */}
              {app.icon && (
                <div
                  class="pointer-events-none absolute -right-6 -top-6 h-36 w-36 select-none opacity-[0.04] transition-all duration-500 group-hover:scale-105 group-hover:opacity-[0.08]"
                  aria-hidden="true"
                >
                  <img
                    src={app.icon}
                    alt=""
                    width="144"
                    height="144"
                    class="h-full w-full object-contain filter grayscale"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}

              <div class="p-5 flex flex-col flex-1">
                {/* Micro-header */}
                <div class="flex items-center justify-between gap-2 text-xs font-mono tracking-wider">
                  <div class="flex items-center gap-1.5 min-w-0">
                    <span
                      class="inline-block h-1.5 w-1.5 shrink-0 rounded-full"
                      style="background-color: var(--app-accent); box-shadow: 0 0 8px var(--app-accent);"
                      aria-hidden="true"
                    />
                    <span class="font-semibold uppercase tracking-wider text-[11px] text-accent/90 truncate">
                      {task.label[lang]}
                    </span>
                  </div>
                  {hasData && (
                    <span class="shrink-0 rounded border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] font-mono text-[var(--text-dim)]">
                      {dl?.tag}
                    </span>
                  )}
                </div>

                {/* Identity: Icon + Name */}
                <div class="mt-4 flex items-center gap-3.5">
                  <a
                    href={appPage}
                    aria-label={detailsAria}
                    class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-base-100/90 p-2 shadow-sm transition-colors group-hover:border-accent/40"
                  >
                    {app.icon ? (
                      <img
                        src={app.icon}
                        alt=""
                        width="48"
                        height="48"
                        class="h-10 w-10 object-contain drop-shadow"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="text-2xl select-none">{app.emoji}</span>
                    )}
                  </a>
                  <div class="min-w-0 flex-1">
                    <h3 class="text-xl font-bold tracking-tight text-white transition-colors group-hover:text-accent">
                      <a href={appPage} aria-label={detailsAria} class="hover:underline underline-offset-4 decoration-accent/40">
                        {app.name}
                      </a>
                    </h3>
                    <p class="text-xs text-[var(--text-dim)]">Windows 10 / 11 · 64-bit</p>
                  </div>
                </div>

                {/* Tagline */}
                <p class="mt-3.5 text-[13.5px] leading-relaxed text-[var(--text-dim)] line-clamp-2 min-h-[2.6rem]">
                  {app.tagline[lang]}
                </p>

                {/* Download Specs Key-Value List */}
                <div class="mt-4 pt-3.5 border-t border-white/5 flex flex-col gap-2 text-xs">
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
                      {en ? 'Installer size' : 'Tamaño instalador'}
                    </span>
                    <span class="font-medium text-white/90 text-right font-mono text-[11px]">
                      {inst ? fmtSize(inst.size) : (en ? 'Standard' : 'Estándar')}
                    </span>
                  </div>
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
                      {en ? 'Release date' : 'Actualización'}
                    </span>
                    <span class="font-medium text-white/90 text-right font-mono text-[11px]">
                      {dl?.publishedAt
                        ? new Date(dl.publishedAt).toLocaleDateString(en ? 'en-US' : 'es-ES', {
                            month: 'short',
                            day: 'numeric',
                            year: 'numeric',
                          })
                        : (en ? 'Active' : 'Activo')}
                    </span>
                  </div>
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
                      {en ? 'License & Stack' : 'Licencia y Stack'}
                    </span>
                    <span class="font-medium text-white/90 text-right truncate max-w-[62%]" title={`${app.license} · ${app.stack}`}>
                      {app.license} · {app.stack}
                    </span>
                  </div>
                  {app.winget && (
                    <div class="flex items-center justify-between gap-3">
                      <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
                        winget
                      </span>
                      <code class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-accent font-mono text-[10.5px]">
                        {app.winget}
                      </code>
                    </div>
                  )}
                </div>
              </div>

              {/* Actions footer */}
              <div class="p-5 pt-3 border-t border-white/5 bg-white/[0.015] flex flex-col gap-2.5">
                {inst ? (
                  <a
                    href={inst.url}
                    aria-label={`${c.dlLink} ${app.name}`}
                    class="flex w-full min-h-11 items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-bold text-primary-content bg-primary hover:brightness-105 active:scale-[0.99] transition shadow-md shadow-primary/10"
                    data-umami-event="download_click"
                    data-umami-event-app={app.slug}
                    data-umami-event-format="installer"
                    data-umami-event-source="download-page"
                    data-download-start
                  >
                    <NavIcon name="download" size={17} />
                    <span>{c.dlLink} · {fmtSize(inst.size)}</span>
                  </a>
                ) : (
                  <a
                    href={appPage}
                    class="flex w-full min-h-11 items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-bold text-primary-content bg-primary hover:brightness-105 active:scale-[0.99] transition shadow-md shadow-primary/10"
                    data-umami-event="download_click"
                    data-umami-event-app={app.slug}
                    data-umami-event-format="installer"
                    data-umami-event-source="download-page"
                  >
                    <NavIcon name="download" size={17} />
                    <span>{c.dlLink}</span>
                  </a>
                )}

                <div class="flex flex-wrap items-center justify-between gap-y-1.5 text-xs px-0.5 pt-0.5 text-[var(--text-dim)]">
                  <a
                    href={appPage}
                    aria-label={detailsAria}
                    class="font-medium text-accent hover:underline flex items-center gap-1 group/link"
                  >
                    <span>{en ? 'Details' : 'Detalles'}</span>
                    <span class="transition-transform group-hover/link:translate-x-0.5" aria-hidden="true">→</span>
                  </a>

                  <div class="flex items-center gap-3 font-mono text-[11px]">
                    {dl && dl.portable && (
                      <a
                        href={dl.portable.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-white transition"
                        data-umami-event="download_click"
                        data-umami-event-app={app.slug}
                        data-umami-event-format="portable"
                        data-umami-event-source="download-page"
                        data-download-start
                      >
                        {dl.portable.name.toLowerCase().endsWith('.exe') ? 'Portable (.exe)' : 'Portable (.zip)'}
                      </a>
                    )}
                    {hasData && dl && (
                      <a
                        href={dl.checksum ? dl.checksum.url : dl.releaseUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hover:text-white transition"
                      >
                        {c.verLink}
                      </a>
                    )}
                    <a
                      href={`${app.repo}/releases`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hover:text-white transition"
                    >
                      {c.relLink}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
      <p id="dl-empty" class="hidden mt-6 text-center text-sm text-[#9a9aa5]">{c.noResults}</p>
    </section>


    <details class="cg-collapse cg-collapse-arrow mt-10 scroll-mt-20" id="install-help">
      <summary class="cg-collapse-title">{en ? "Installation help and requirements" : "Ayuda de instalación y requisitos"}</summary>
      <div class="cg-collapse-content">
    <div class:list={["mt-8 grid gap-4 text-left", hasWinget ? "sm:grid-cols-3" : "sm:grid-cols-2"]}>
      <div class="card p-5">
        <span class="inline-flex text-accent"><NavIcon name="download" size={24} /></span>
        <h2 class="mt-2 font-bold">{c.m1Title}</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">{c.m1Text}</p>
      </div>
      <div class="card p-5">
        <span class="inline-flex text-accent"><FeatureSymbol name="folder" /></span>
        <h2 class="mt-2 font-bold">{c.m2Title}</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">{c.m2Text}</p>
      </div>
      {hasWinget && <div class="card p-5">
        <span class="inline-flex text-accent"><FeatureSymbol name="keyboard" /></span>
        <h2 class="mt-2 font-bold">3. winget</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">
          <code class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-[#00f2ff] text-xs">winget install &lt;id&gt;</code>
          <span class="block mt-1.5">{c.m3Note}</span>
        </p>
      </div>}
    </div>

    <section class="mt-6 card p-5 text-sm text-[#c9c9d1] leading-relaxed text-left">
      <p><strong class="text-white">{'\u{1F9E9}'} {reqLabel}</strong> {c.reqStack}</p>
      <details id={c.ssAnchor} class="ss-details mt-3">
        <summary>
          <strong class="text-white">{'\u{1F50F}'} SmartScreen</strong>
          <span class="ss-hint">{c.ssOpen}</span>
          <svg class="ss-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </summary>
        <div class="ss-body">
          <p>{c.ssIntro}</p>
          <ol class="ss-steps">
            <li class="ss-step">
              <span class="ss-num" aria-hidden="true">1</span>
              <div class="ss-step-main">
                <p>{c.ssStep1}</p>
                <div class="ss-dlg" role="img" aria-label={c.dlg1Title}>
                  <div class="ss-dlg-body">
                    <div class="ss-dlg-icon" aria-hidden="true">🛡️</div>
                    <div>
                      <p class="ss-dlg-title">{c.dlg1Title}</p>
                      <p class="ss-dlg-text">{c.dlg1Text}</p>
                      <p class="ss-dlg-more">{c.dlg1MoreInfo}</p>
                    </div>
                  </div>
                  <div class="ss-dlg-actions">
                    <span class="ss-dlg-btn">{c.dlg1Cancel}</span>
                  </div>
                </div>
              </div>
            </li>
            <li class="ss-step">
              <span class="ss-num" aria-hidden="true">2</span>
              <div class="ss-step-main">
                <p>{c.ssStep2}</p>
              </div>
            </li>
            <li class="ss-step">
              <span class="ss-num" aria-hidden="true">3</span>
              <div class="ss-step-main">
                <p>{c.dlg2Note}</p>
                <div class="ss-dlg" role="img" aria-label={`${c.dlg1Title}: ${c.dlg2App}`}>
                  <div class="ss-dlg-body">
                    <div class="ss-dlg-icon" aria-hidden="true">🛡️</div>
                    <div>
                      <p class="ss-dlg-title">{c.dlg1Title}</p>
                      <p class="ss-dlg-pub">{c.dlg2App}</p>
                      <p class="ss-dlg-pub">{c.dlg2Editor}</p>
                      <p class="ss-dlg-more">{c.dlg1MoreInfo}</p>
                    </div>
                  </div>
                  <div class="ss-dlg-actions">
                    <span class="ss-dlg-pub">{c.dlg2Publisher}</span>
                    <span class="ss-dlg-btn">{c.dlg1Cancel}</span>
                  </div>
                </div>
              </div>
            </li>
            <li class="ss-step">
              <span class="ss-num" aria-hidden="true">4</span>
              <div class="ss-step-main">
                <p>{c.ssStep3}</p>
                <div class="ss-dlg" role="img" aria-label={`${c.dlg1Title}: ${c.dlg2Run}`}>
                  <div class="ss-dlg-body">
                    <div class="ss-dlg-icon" aria-hidden="true">🛡️</div>
                    <div>
                      <p class="ss-dlg-title">{c.dlg1Title}</p>
                      <p class="ss-dlg-more">{c.dlg1MoreInfo}</p>
                    </div>
                  </div>
                  <div class="ss-dlg-actions">
                    <span class="ss-dlg-pub">{c.dlg2Publisher}</span>
                    <span class="ss-dlg-btn ss-dlg-run">{c.dlg2Run}</span>
                  </div>
                </div>
              </div>
            </li>
          </ol>
          <p class="ss-why"><strong>{c.ssWhyTitle}:</strong> {c.ssWhyText}</p>
        </div>
      </details>
    </section>

    {wingetApps.length > 0 && (
      <section class="mt-6 card p-6 text-left">
        <h2 class="font-bold">{'\u2328\uFE0F'} {c.wingetTitle}</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">{c.wingetText}</p>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <code id="winget-line" class="px-3 py-2 rounded-lg bg-white/5 border border-white/10 text-[#00f2ff] text-xs break-all">{wingetLine}</code>
          <button type="button" id="winget-copy" data-copied={c.copiedBtn} class="text-xs font-semibold px-3 py-2 rounded-lg border border-white/10 hover:border-[#00f2ff] hover:text-white text-[#9a9aa5] transition-colors">
            {c.copyBtn}
          </button>
        </div>
      </section>
    )}

    <section class="mt-10 card p-5 text-left overflow-x-auto">
      <h2 class="font-bold">{c.cmpTitle}</h2>
      <table class="mt-4 w-full text-sm min-w-[540px]">
        <thead>
          <tr class="text-left">
            <th class="py-2 pr-4"></th>
            {compareCols.map((col: string) => <th class="py-2 pr-4 font-semibold text-white">{col}</th>)}
          </tr>
        </thead>
        <tbody class="text-[#c9c9d1]">
          {compareRows.map((row: any) => (
            <tr class="border-t border-white/5">
              <td class="py-2.5 pr-4 text-[#9a9aa5]">{row.label}</td>
              {row.v.map((cell: string) => <td class="py-2.5 pr-4">{cell}</td>)}
            </tr>
          ))}
        </tbody>
      </table>
    </section>
      </div>
    </details>
  </div>
</BaseLayout>

<style>
  .dl-logo-icon {
    filter: none;
    transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .dl-card:hover .dl-logo-icon,
  .dl-logo:hover .dl-logo-icon {
    transform: scale(1.05);
    filter: drop-shadow(0 0 7px rgba(0, 242, 255, 0.24));
  }

  .ss-details {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    background: rgba(255, 255, 255, 0.03);
    overflow: hidden;
  }
  .ss-details summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    transition: background 0.15s ease;
  }
  .ss-details summary::-webkit-details-marker { display: none; }
  .ss-details summary:hover { background: rgba(255, 255, 255, 0.04); }
  .ss-details[open] summary { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .ss-hint { color: #9a9aa5; font-size: 12px; flex: 1; min-width: 180px; }
  .ss-chevron { color: #9a9aa5; flex-shrink: 0; transition: transform 0.2s ease; }
  .ss-details[open] .ss-chevron { transform: rotate(180deg); }
  .ss-body { padding: 1rem; }
  .ss-steps { margin: 1rem 0 0; padding: 0; display: grid; gap: 1rem; list-style: none; }
  .ss-step { display: flex; gap: 0.75rem; align-items: flex-start; }
  .ss-num {
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(0, 242, 255, 0.4);
    color: #00f2ff;
    font-size: 12px;
    font-weight: 700;
  }
  .ss-step-main { min-width: 0; flex: 1; }
  .ss-step-main > p { margin: 0.2rem 0 0.5rem; }
  /* Win11-style SmartScreen dialog mockups (illustrative, no copyrighted assets) */
  .ss-dlg {
    max-width: 430px;
    border-radius: 8px;
    background: #f3f3f3;
    color: #1b1b1b;
    border: 1px solid #d0d0d0;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.4);
    font-size: 12px;
    line-height: 1.45;
    overflow: hidden;
  }
  .ss-dlg-body { display: flex; gap: 12px; padding: 16px 16px 6px; }
  .ss-dlg-icon { font-size: 24px; line-height: 1; flex-shrink: 0; }
  .ss-dlg-title { font-weight: 600; color: #1b1b1b; margin: 0; }
  .ss-dlg-text { color: #5c5c5c; margin: 2px 0 4px; }
  .ss-dlg-more { color: #0067c0; font-weight: 600; margin: 4px 0 0; text-decoration: underline; text-underline-offset: 2px; }
  .ss-dlg-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 14px;
  }
  .ss-dlg-pub { color: #5c5c5c; font-size: 11px; margin-right: auto; }
  .ss-dlg-btn {
    background: #fbfbfb;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 5px 16px;
    color: #1b1b1b;
    white-space: nowrap;
  }
  .ss-dlg-run { background: #0067c0; border-color: #0067c0; color: #ffffff; }
  .ss-why { margin: 1.25rem 0 0; color: #9a9aa5; font-size: 12.5px; }
  .ss-why strong { color: #c9c9d1; }
</style>

<script is:inline>
  (function () {
    // Download page: live card filter
    var input = document.getElementById('dl-search');
    var empty = document.getElementById('dl-empty');
    const revealHelp = () => {
      const target = document.getElementById(window.location.hash.slice(1));
      if (!target || !['install-help', 'smartscreen'].includes(target.id)) return;
      let details = target.closest('details');
      while (details) {
        details.open = true;
        details = details.parentElement?.closest('details');
      }
      requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
    };
    revealHelp();
    window.addEventListener('hashchange', revealHelp);
    if (input) {
      input.addEventListener('input', function () {
        var normalize = (value) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
        var q = normalize(input.value.trim());
        var visible = 0;
        document.querySelectorAll('.dl-card').forEach(function (card) {
          var show = !q || normalize(card.getAttribute('data-search') || '').indexOf(q) !== -1;
          card.style.display = show ? '' : 'none';
          if (show) visible++;
        });
        if (empty) empty.classList.toggle('hidden', visible !== 0);
        var count = document.getElementById('dl-count');
        if (count) count.textContent = count.dataset.label.replace('{count}', String(visible));
      });
    }

    // winget one-liner copy button
    var btn = document.getElementById('winget-copy');
    var line = document.getElementById('winget-line');
    if (btn && line) {
      btn.addEventListener('click', function () {
        var orig = btn.textContent;
        var done = function () {
          btn.textContent = btn.getAttribute('data-copied') || 'OK';
          setTimeout(function () { btn.textContent = orig; }, 1200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(line.textContent || '').then(done).catch(done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = line.textContent || '';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
    }
  })();
</script>
