---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../data/ui';
import { site } from '../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const title = en ? 'FAQ & Support — CyberGems' : 'FAQ y Soporte — CyberGems';
const description = en
  ? 'Is it really free? Is it portable? How do I report a bug? Answers plus where to get help for any CyberGems app.'
  : '¿De verdad es gratis? ¿Es portable? ¿Cómo reporto un bug? Respuestas y dónde pedir ayuda para cualquier app CyberGems.';
const path = en ? '/faq' : '/es/faq';

const faqs = en ? [
  { q: 'Is it really free — even for companies?', a: 'Yes. All 10 apps are GPLv3: free forever, including commercial use. No ads, no paywalls, no “pro” tier.' },
  { q: 'Do I need an account? Is there telemetry?', a: 'No and no. Everything works offline and local-first. Network is only used when you explicitly ask (e.g. check for updates, uploads you configure). See /privacy.' },
  { q: 'What are the system requirements?', a: 'Windows 10 / 11, 64-bit. Most apps run on .NET 9/10 (check the stack chip on each app page). No admin required for portable builds.' },
  { q: 'Installer, portable or winget?', a: 'Releases include a Setup .exe installer; portable zips where available. Or run: winget install <package-id> shown on each app page. See /download.' },
  { q: 'Windows warns about an unknown publisher. Is it safe?', a: 'Expected — there is no paid code-signing certificate yet. Verify via the release SHA, VirusTotal, or build from source. Donations fund the certificate.' },
  { q: 'How do I report a bug or request a feature?', a: 'Open an issue in the app repo (each app page links Source / Releases). Include Windows version, app version, and steps to reproduce.' },
  { q: 'How do I update?', a: 'Download the new Setup .exe from the app page or winget upgrade. Portable builds: replace the folder. Your local data is preserved.' },
] : [
  { q: '¿De verdad es gratis — incluso para empresas?', a: 'Sí. Las 10 apps son GPLv3: gratis para siempre, incluido uso comercial. Sin anuncios, sin muros de pago, sin tier “pro”.' },
  { q: '¿Necesito cuenta? ¿Hay telemetría?', a: 'No y no. Todo funciona offline y local-first. La red solo se usa cuando tú lo pides (p. ej. buscar updates, subidas que configuras). Ver /privacidad.' },
  { q: '¿Requisitos del sistema?', a: 'Windows 10 / 11, 64 bits. La mayoría usan .NET 9/10 (mira el chip de stack en cada app). Sin admin para builds portables.' },
  { q: '¿Instalador, portable o winget?', a: 'Los releases incluyen Setup .exe; zips portables donde aplique. O: winget install <package-id> de cada página. Ver /download.' },
  { q: 'Windows avisa de editor desconocido. ¿Es seguro?', a: 'Esperado — aún no hay certificado de firma de pago. Verifica con el SHA del release, VirusTotal o compilando desde el código. Las donaciones lo financian.' },
  { q: '¿Cómo reporto un bug o pido una feature?', a: 'Abre un issue en el repo de la app (cada página enlaza Código / Versiones). Incluye versión de Windows, versión de la app y pasos.' },
  { q: '¿Cómo actualizo?', a: 'Descarga el nuevo Setup .exe desde la página o winget upgrade. Portables: reemplaza la carpeta. Tus datos locales se conservan.' },
];
---

<BaseLayout title={title} description={description} lang={lang} path={path}>
  <div class="max-w-3xl mx-auto px-5 pt-16 pb-4">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight"><span class="text-gradient brand-glow">FAQ</span></h1>
      <p class="mt-3 text-[#9a9aa5]">{en ? 'Quick answers. Still stuck? Open an issue — links below.' : 'Respuestas rápidas. ¿Sigues atascado? Abre un issue — enlaces abajo.'}</p>
    </header>
    <div class="mt-8 space-y-3">
      {faqs.map((f) => (
        <details class="card p-5 group">
          <summary class="font-semibold cursor-pointer list-none flex justify-between gap-3">
            <span>{f.q}</span><span class="text-[#00f2ff] group-open:rotate-45 transition-transform">+</span>
          </summary>
          <p class="mt-2.5 text-sm text-[#c9c9d1] leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
    <section class="mt-8 card p-6 text-center">
      <h2 class="font-bold">{en ? 'Need human help?' : '¿Necesitas ayuda humana?'}</h2>
      <p class="mt-2 text-sm text-[#9a9aa5]">{en ? 'Bugs and ideas live per-app so they get fixed faster.' : 'Bugs e ideas viven por app para arreglarse más rápido.'}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href={site.githubOrg} target="_blank" rel="noopener noreferrer" class="btn-ghost">GitHub ↗</a>
        <a href={site.discussions} target="_blank" rel="noopener noreferrer" class="btn-ghost">Discussions ↗</a>
        <a href={en ? '/docs' : '/es/docs'} class="btn-primary">{en ? 'Browse docs' : 'Ver docs'}</a>
      </div>
    </section>
  </div>
</BaseLayout>
