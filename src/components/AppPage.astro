---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Lang } from '../data/ui';
import { apps, type CyberApp } from '../data/apps';

interface Props {
  app: CyberApp;
  lang: Lang;
  /** Whether the app's wiki was fetched at build time (enables on-site docs) */
  docsAvailable?: boolean;
}

const { app, lang, docsAvailable = false } = Astro.props;
const t = ui[lang];
const homePath = lang === 'en' ? '/' : '/es/';
const title = `${app.name} — CyberGems`;
const shortDesc = app.tagline[lang];
const description = shortDesc.length > 155 ? `${shortDesc.slice(0, 152)}...` : `${shortDesc} ${app.stack} for Windows. GPLv3.`;
const releasesUrl = `${app.repo}/releases/latest`;
const ogImage = lang === 'es' ? `/og/es/${app.slug}.png` : `/og/${app.slug}.png`;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://cybergems.org${lang === 'es' ? '/es/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: app.name, item: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/` },
  ],
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: app.description[lang],
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows 10, Windows 11',
  url: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`,
  downloadUrl: releasesUrl,
  softwareVersion: undefined,
  author: { '@type': 'Organization', name: 'CyberGems', url: 'https://cybergems.org' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: `https://www.gnu.org/licenses/gpl-3.0.html`,
};
// CMS uploads write absolute public paths ("/screenshots/..."); hand-made
// entries may use a bare filename inside the app's own screenshots folder.
const shotSrc = app.screenshot
  ? app.screenshot.startsWith('/')
    ? app.screenshot
    : `/screenshots/${app.slug}/${app.screenshot}`
  : null;
const related = apps.filter((a) => a.slug !== app.slug).slice(0, 3);
const downloadPath = lang === 'en' ? '/download' : '/es/download';
const faqPath = lang === 'en' ? '/faq' : '/es/faq';
const pageUrl = `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`;
const shareText = lang === 'en'
  ? `${app.name} — free & open-source desktop tool for Windows`
  : `${app.name} — herramienta libre y de código abierto para Windows`;
const xUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareText)}&url=${encodeURIComponent(pageUrl)}`;
const fbUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(pageUrl)}`;
const rdUrl = `https://www.reddit.com/submit?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(shareText)}`;
const tgUrl = `https://t.me/share/url?url=${encodeURIComponent(pageUrl)}&text=${encodeURIComponent(shareText)}`;
const liUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(pageUrl)}`;
const mailUrl = `mailto:?subject=${encodeURIComponent(shareText)}&body=${encodeURIComponent(shareText + ' ' + pageUrl)}`;
---

<BaseLayout title={title} description={description} lang={lang} path={lang === 'en' ? `/apps/${app.slug}` : `/es/apps/${app.slug}`} ogImage={ogImage} jsonLd={[breadcrumbLd, appLd]}>
  <nav aria-label="Breadcrumb" class="max-w-5xl mx-auto px-5 pt-6">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-[#9a9aa5]">
      <li><a href={homePath} class="hover:text-white transition-colors">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`${homePath}#apps`} class="hover:text-white transition-colors">Apps</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-white font-medium">{app.name}</li>
    </ol>
  </nav>
  <article class="max-w-5xl mx-auto px-5 pt-6 pb-4">
    <a href={homePath + '#apps'} class="text-sm text-[#9a9aa5] hover:text-white transition-colors">{t.backHome}</a>

    <!-- App header -->
    <header class="mt-8 flex flex-col sm:flex-row sm:items-center gap-6">
      <div
        class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl shrink-0 border border-white/10"
        style={`background: radial-gradient(120% 120% at 20% 0%, ${app.accent}33 0%, transparent 60%); box-shadow: 0 0 40px -12px ${app.accent}66;`}
        aria-hidden="true"
      >
        {app.icon ? <img src={app.icon} alt="" width="64" height="64" class="h-16 w-16 object-contain" /> : app.emoji}
      </div>
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{app.name}</h1>
        <p class="mt-2 text-lg text-[#9a9aa5]">{app.tagline[lang]}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="chip">🧩 {app.stack}</span>
          <span class="chip">📄 {app.license}</span>
          <span class="chip">🖥️ Windows 10</span>
          <span class="chip">🖥️ Windows 11</span>
          <span class="chip">⚙️ 64-bit</span>
        </div>
      </div>
    </header>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={releasesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        data-gh-repo={`CyberGems/${app.slug}`}
        data-umami-event="download_click"
        data-umami-event-app={app.slug}
        data-umami-event-format="installer"
        data-umami-event-source="app-page"
        data-download-start
      >
        ⬇ {t.downloadCta}<span data-gh-version></span>
      </a>
      <a href={`${app.repo}/releases`} target="_blank" rel="noopener noreferrer" class="btn-ghost">{t.releasesCta} ↗</a>
      <a href={app.repo} target="_blank" rel="noopener noreferrer" class="btn-ghost">⌨ {t.repoCta} ↗</a>
      {docsAvailable ? (
        <a href={`${homePath}docs/${app.slug}/`} class="btn-ghost">📖 {t.wikiCta}</a>
      ) : (
        app.wiki && (
          <a href={app.wiki} target="_blank" rel="noopener noreferrer" class="btn-ghost">📖 {t.wikiCta} ↗</a>
        )
      )}
    </div>

    {app.winget && (
      <p class="mt-4 text-sm text-[#9a9aa5]">
        {t.wingetHint}
        <code class="ml-2 px-2 py-1 rounded-md bg-white/5 border border-white/10 text-[#00f2ff] text-xs">winget install {app.winget}</code>
      </p>
    )}

    <!-- Screenshot / placeholder -->
    <div
      class="mt-10 rounded-2xl border border-white/10 overflow-hidden aspect-video flex items-center justify-center relative"
      style={`background: radial-gradient(100% 100% at 50% 0%, ${app.accent}1f 0%, transparent 60%), #10131c;`}
    >
      {shotSrc ? (
        <img src={shotSrc} alt={`${app.name} — ${app.tagline[lang]}`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="1280" height="720" />
      ) : (
        <div class="text-center select-none" aria-hidden="true">
          {app.icon ? <img src={app.icon} alt="" width="112" height="112" class="h-28 w-28 object-contain mb-3 opacity-95" /> : <div class="text-7xl mb-3 opacity-90">{app.emoji}</div>}
          <p class="text-sm text-[#9a9aa5]">{t.shotPlaceholder}</p>
        </div>
      )}
    </div>

    <!-- Description -->
    <p class="mt-10 text-lg leading-relaxed text-[#c9c9d1]">{app.description[lang]}</p>

    <!-- How it works (optional per app: 3-step strip) -->
    {app.howItWorks && (
      <section class="mt-16 text-center" aria-label={app.howItWorks.title[lang]}>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{app.howItWorks.title[lang]}</h2>
        <div class="mt-10 grid gap-10 sm:grid-cols-3 sm:gap-6">
          {app.howItWorks.steps.map((step, i) => (
            <div class="relative flex flex-col items-center px-2">
              {i < app.howItWorks!.steps.length - 1 && (
                <div
                  aria-hidden="true"
                  class="hidden sm:block absolute top-7 left-[calc(50%+3.2rem)] w-[calc(100%-6.4rem)] border-t-2 border-dashed border-white/15"
                />
              )}
              <div
                class="w-14 h-14 rounded-2xl flex items-center justify-center text-2xl font-extrabold border border-white/10"
                style={`background: radial-gradient(120% 120% at 20% 0%, ${app.accent}2e 0%, transparent 65%), #141828; box-shadow: 0 0 32px -10px ${app.accent}55; color: ${app.accent};`}
                aria-hidden="true"
              >
                {i + 1}
              </div>
              <div class="mt-5 text-2xl" aria-hidden="true">{step.icon}</div>
              <p class="mt-3 font-bold text-lg">{step.title[lang]}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-[#9a9aa5] max-w-xs">{step.text[lang]}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Highlights (optional per app: icon cards grid) -->
    {app.highlights && (
      <section class="mt-14" aria-label={t.featuresTitle + ' ' + app.name}>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {app.highlights.map((h) => (
            <div class="card p-6 text-left">
              <div
                class="w-11 h-11 rounded-xl flex items-center justify-center text-xl border border-white/10"
                style={`background: ${(h.color ?? app.accent)}14; color: ${h.color ?? app.accent};`}
                aria-hidden="true"
              >
                {h.icon}
              </div>
              <p class="mt-4 font-bold text-lg">{h.title[lang]}</p>
              <p class="mt-2 text-[15px] leading-relaxed text-[#9a9aa5]">{h.text[lang]}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Features -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight">
      {t.featuresTitle} {app.name}
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {app.features.map((feature) => (
        <li class="card flex items-start gap-3 p-4">
          <span
            class="mt-[7px] w-2 h-2 rounded-full shrink-0"
            style={`background: ${app.accent}; box-shadow: 0 0 10px ${app.accent};`}
          >
          </span>
          <span class="text-sm leading-relaxed">{feature[lang]}</span>
        </li>
      ))}
    </ul>

    <!-- Use cases (optional per app: "By Role" / "By Task") -->
    {app.useCases && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold tracking-tight">
          {t.useCasesTitle}
        </h2>
        <div class="mt-6 grid gap-10 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <h3 class="text-xl font-bold" style={`color: ${app.accent};`}>
            {lang === 'en' ? 'By Role' : 'Por rol'}
          </h3>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {app.useCases.roles.map((role) => (
              <div class="flex items-start gap-3">
                <span class="text-2xl shrink-0" aria-hidden="true">{role.icon}</span>
                <div>
                  <p class="font-bold text-sm">{role.title[lang]}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[#9a9aa5]">{role.text[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="lg:col-span-2">
          <h3 class="text-xl font-bold" style={`color: ${app.accent};`}>
            {lang === 'en' ? 'By Task' : 'Por tarea'}
          </h3>
          <div class="mt-6 grid gap-6">
            {app.useCases.tasks.map((task) => (
              <div class="flex items-start gap-3">
                <span class="text-2xl shrink-0" aria-hidden="true">{task.icon}</span>
                <div>
                  <p class="font-bold text-sm">{task.title[lang]}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[#9a9aa5]">{task.text[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        </div>
      </section>
    )}

    <!-- Requirements & safety -->
    <section class="mt-12 card p-6 text-sm leading-relaxed">
      <h2 class="font-bold text-base">🖥️ {lang === 'en' ? 'Requirements & safety' : 'Requisitos y seguridad'}</h2>
      <ul class="mt-3 space-y-1.5 text-[#c9c9d1]">
        <li>· Windows 10 / 11, 64-bit — {app.stack}</li>
        <li>
          · {app.winget
            ? (lang === 'en' ? 'Installer, portable or' : 'Instalador, portable o')
            : (lang === 'en' ? 'Installer or portable' : 'Instalador o portable')}
          {app.winget && (
            <code class="ml-1.5 px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-[#00f2ff] text-xs">
              winget install {app.winget}
            </code>
          )}
        </li>
        <li>· 🔏 {lang === 'en' ? '“Unknown publisher” SmartScreen warning is expected (no paid certificate yet). Verify via release SHA / VirusTotal or build from source.' : 'Aviso SmartScreen de “editor desconocido” esperado (aún sin certificado de pago). Verifica con el SHA / VirusTotal o compilando.'}</li>
      </ul>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={downloadPath} class="font-semibold text-sm" style={`color: ${app.accent};`}>{lang === 'en' ? 'All install options →' : 'Todas las opciones →'}</a>
        <a href={faqPath} class="text-sm text-[#9a9aa5] hover:text-white transition-colors">FAQ →</a>
      </div>
    </section>

    <!-- Share -->
    <section class="mt-12">
      <h2 class="text-xl font-bold">{lang === 'en' ? 'Share' : 'Compartir'}</h2>
      <p class="mt-2 text-sm text-[#9a9aa5]">
        {lang === 'en'
          ? `Enjoying ${app.name}? Help other people discover it:`
          : `¿Disfrutando de ${app.name}? Ayuda a más gente a descubrirla:`}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a href={xUrl} target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors" aria-label="Share on X">
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#1DA1F2" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          <span>X</span>
        </a>
        <a href={fbUrl} target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors" aria-label="Share on Facebook">
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#1877F2" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>Facebook</span>
        </a>
        <a href={rdUrl} target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors" aria-label="Share on Reddit">
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#FF4500" fill="currentColor" aria-hidden="true"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
          <span>Reddit</span>
        </a>
        <a href={tgUrl} target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors" aria-label="Share on Telegram">
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#26A5E4" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          <span>Telegram</span>
        </a>
        <a href={liUrl} target="_blank" rel="noopener noreferrer" class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors" aria-label="Share on LinkedIn">
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#0A66C2" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/></svg>
          <span>LinkedIn</span>
        </a>
        <a href={mailUrl} class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors" aria-label="Share by Email">
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#EA4335" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>{lang === 'en' ? 'Email' : 'Correo'}</span>
        </a>
        <button
          type="button"
          id="cg-copy-link"
          class="card flex items-center gap-2 px-4 py-2.5 text-sm font-medium hover:text-white transition-colors cursor-pointer"
          data-url={pageUrl}
          data-copied={lang === 'en' ? 'Copied!' : '¡Copiado!'}
          aria-label={lang === 'en' ? 'Copy link' : 'Copiar enlace'}
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" style="color:#9a9aa5" fill="currentColor" aria-hidden="true"><path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V19h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/></svg>
          <span>{lang === 'en' ? 'Copy link' : 'Copiar enlace'}</span>
        </button>
      </div>
    </section>

    <!-- Related apps -->
    <section class="mt-12">
      <h2 class="text-xl font-bold">{lang === 'en' ? 'Pairs well with' : 'Combina bien con'}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {related.map((r) => (
          <a href={lang === 'en' ? `/apps/${r.slug}` : `/es/apps/${r.slug}`} class="card p-4 block">
            {r.icon ? <img src={r.icon} alt="" width="48" height="48" class="h-12 w-12 object-contain" /> : <div class="text-3xl" aria-hidden="true">{r.emoji}</div>}
            <p class="mt-2 font-bold text-sm">{r.name}</p>
            <p class="text-xs text-[#9a9aa5] truncate">{r.tagline[lang]}</p>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  // Resolve the "Download latest" buttons to the direct .exe asset of each
  // repo's latest GitHub release (asset names include the version, so the
  // static /releases/latest/download/<name> shortcut does not apply).
  // Falls back silently to the release page on API failure, and caches the
  // resolved URL for 10 minutes to stay well within the API rate limit.
  (function () {
    var TTL = 10 * 60 * 1000;

    function pickInstaller(assets) {
      var exe = (assets || []).filter(function (a) {
        return /\.exe$/i.test(a.name) && !/portable/i.test(a.name);
      });
      if (exe.length === 0) return null;
      return (
        exe.find(function (a) { return /setup|install/i.test(a.name); }) || exe[0]
      );
    }

    function resolveButton(btn) {
      var repo = btn.getAttribute('data-gh-repo');
      if (!repo) return;

      try {
        var cache = JSON.parse(localStorage.getItem('cg-rel-' + repo) || 'null');
        if (cache && cache.url && Date.now() - cache.ts < TTL) {
          btn.href = cache.url;
          showVersion(btn, cache.tag);
          return;
        }
      } catch (e) { /* ignore cache errors */ }

      fetch('https://api.github.com/repos/' + repo + '/releases/latest', {
        headers: { Accept: 'application/vnd.github+json' },
      })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (release) {
          if (!release || !release.assets) return;
          var asset = pickInstaller(release.assets);
          if (!asset) return;
          btn.href = asset.browser_download_url;
          showVersion(btn, release.tag_name);
          try {
            localStorage.setItem(
              'cg-rel-' + repo,
              JSON.stringify({ url: asset.browser_download_url, tag: release.tag_name, ts: Date.now() })
            );
          } catch (e) { /* storage unavailable */ }
        })
        .catch(function () { /* keep the release page as fallback */ });
    }

    function showVersion(btn, tag) {
      var span = btn.querySelector('[data-gh-version]');
      if (span && tag) span.textContent = ' · ' + tag;
    }

    document.querySelectorAll('a[data-gh-repo]').forEach(resolveButton);
  })();
</script>

<script is:inline>
  // Copy-link button in the Share section: copies the current app page URL
  // with a temporary "Copied!" confirmation (falls back to execCommand).
  (function () {
    var btn = document.getElementById('cg-copy-link');
    if (!btn) return;
    var span = btn.querySelector('span');
    var original = span ? span.textContent : '';
    var timer;
    btn.addEventListener('click', function () {
      var url = btn.getAttribute('data-url') || location.href;
      function done() {
        if (!span) return;
        span.textContent = btn.getAttribute('data-copied') || 'Copied!';
        clearTimeout(timer);
        timer = setTimeout(function () { span.textContent = original; }, 2000);
      }
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(function () {});
      } else {
        var ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); done(); } catch (e) { /* ignore */ }
        document.body.removeChild(ta);
      }
    });
  })();
</script>
