---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Lang } from '../data/ui';
import { apps, type CyberApp } from '../data/apps';

interface Props {
  app: CyberApp;
  lang: Lang;
  /** Whether the app's wiki was fetched at build time (enables on-site docs) */
  docsAvailable?: boolean;
}

const { app, lang, docsAvailable = false } = Astro.props;
const t = ui[lang];
const homePath = lang === 'en' ? '/' : '/es/';
const title = `${app.name} — CyberGems`;
const shortDesc = app.tagline[lang];
const description = shortDesc.length > 155 ? `${shortDesc.slice(0, 152)}...` : `${shortDesc} ${app.stack} for Windows. GPLv3.`;
const releasesUrl = `${app.repo}/releases/latest`;
const ogImage = lang === 'es' ? `/og/es/${app.slug}.png` : `/og/${app.slug}.png`;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://cybergems.org${lang === 'es' ? '/es/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: app.name, item: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/` },
  ],
};
const appLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: app.name,
  description: app.description[lang],
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Windows',
  url: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`,
  downloadUrl: releasesUrl,
  softwareVersion: undefined,
  author: { '@type': 'Organization', name: 'CyberGems', url: 'https://cybergems.org' },
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  license: `https://www.gnu.org/licenses/gpl-3.0`,
};
// CMS uploads write absolute public paths ("/screenshots/..."); hand-made
// entries may use a bare filename inside the app's own screenshots folder.
const shotSrc = app.screenshot
  ? app.screenshot.startsWith('/')
    ? app.screenshot
    : `/screenshots/${app.slug}/${app.screenshot}`
  : null;
const related = apps.filter((a) => a.slug !== app.slug).slice(0, 3);
const downloadPath = lang === 'en' ? '/download' : '/es/download';
const faqPath = lang === 'en' ? '/faq' : '/es/faq';
---

<BaseLayout title={title} description={description} lang={lang} path={lang === 'en' ? `/apps/${app.slug}` : `/es/apps/${app.slug}`} ogImage={ogImage} jsonLd={[breadcrumbLd, appLd]}>
  <nav aria-label="Breadcrumb" class="max-w-5xl mx-auto px-5 pt-6">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-[#9a9aa5]">
      <li><a href={homePath} class="hover:text-white transition-colors">Home</a></li>
      <li aria-hidden="true">/</li>
      <li><a href={`${homePath}#apps`} class="hover:text-white transition-colors">Apps</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="text-white font-medium">{app.name}</li>
    </ol>
  </nav>
  <article class="max-w-5xl mx-auto px-5 pt-6 pb-4">
    <a href={homePath + '#apps'} class="text-sm text-[#9a9aa5] hover:text-white transition-colors">{t.backHome}</a>

    <!-- App header -->
    <header class="mt-8 flex flex-col sm:flex-row sm:items-center gap-6">
      <div
        class="w-20 h-20 rounded-2xl flex items-center justify-center text-4xl shrink-0 border border-white/10"
        style={`background: radial-gradient(120% 120% at 20% 0%, ${app.accent}33 0%, transparent 60%); box-shadow: 0 0 40px -12px ${app.accent}66;`}
        aria-hidden="true"
      >
        {app.emoji}
      </div>
      <div>
        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{app.name}</h1>
        <p class="mt-2 text-lg text-[#9a9aa5]">{app.tagline[lang]}</p>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="chip">🧩 {app.stack}</span>
          <span class="chip">📄 {app.license}</span>
          <span class="chip">🪟 Windows</span>
        </div>
      </div>
    </header>

    <!-- CTAs -->
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href={releasesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary"
        data-gh-repo={`CyberGems/${app.slug}`}
      >
        ⬇ {t.downloadCta}<span data-gh-version></span>
      </a>
      <a href={`${app.repo}/releases`} target="_blank" rel="noopener noreferrer" class="btn-ghost">{t.releasesCta} ↗</a>
      <a href={app.repo} target="_blank" rel="noopener noreferrer" class="btn-ghost">⌨ {t.repoCta} ↗</a>
      {docsAvailable ? (
        <a href={`${homePath}docs/${app.slug}/`} class="btn-ghost">📖 {t.wikiCta}</a>
      ) : (
        app.wiki && (
          <a href={app.wiki} target="_blank" rel="noopener noreferrer" class="btn-ghost">📖 {t.wikiCta} ↗</a>
        )
      )}
    </div>

    {app.winget && (
      <p class="mt-4 text-sm text-[#9a9aa5]">
        {t.wingetHint}
        <code class="ml-2 px-2 py-1 rounded-md bg-white/5 border border-white/10 text-[#00f2ff] text-xs">winget install {app.winget}</code>
      </p>
    )}

    <!-- Screenshot / placeholder -->
    <div
      class="mt-10 rounded-2xl border border-white/10 overflow-hidden aspect-video flex items-center justify-center relative"
      style={`background: radial-gradient(100% 100% at 50% 0%, ${app.accent}1f 0%, transparent 60%), #10131c;`}
    >
      {shotSrc ? (
        <img src={shotSrc} alt={`${app.name} — ${app.tagline[lang]}`} class="w-full h-full object-cover" loading="lazy" decoding="async" width="1280" height="720" />
      ) : (
        <div class="text-center select-none" aria-hidden="true">
          <div class="text-7xl mb-3 opacity-90">{app.emoji}</div>
          <p class="text-sm text-[#9a9aa5]">{t.shotPlaceholder}</p>
        </div>
      )}
    </div>

    <!-- Description -->
    <p class="mt-10 text-lg leading-relaxed text-[#c9c9d1]">{app.description[lang]}</p>

    <!-- Features -->
    <h2 class="mt-12 text-2xl font-bold tracking-tight">
      {t.featuresTitle} {app.name}
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {app.features.map((feature) => (
        <li class="card flex items-start gap-3 p-4">
          <span
            class="mt-1 w-2 h-2 rounded-full shrink-0"
            style={`background: ${app.accent}; box-shadow: 0 0 10px ${app.accent};`}
          >
          </span>
          <span class="text-sm leading-relaxed">{feature[lang]}</span>
        </li>
      ))}
    </ul>

    <!-- Use cases (optional per app: "By Role" / "By Task") -->
    {app.useCases && (
      <section class="mt-12 grid gap-10 lg:grid-cols-5">
        <div class="lg:col-span-3">
          <h2 class="text-xl font-bold" style={`color: ${app.accent};`}>
            {lang === 'en' ? 'By Role' : 'Por rol'}
          </h2>
          <div class="mt-6 grid gap-6 sm:grid-cols-2">
            {app.useCases.roles.map((role) => (
              <div class="flex items-start gap-3">
                <span class="text-2xl shrink-0" aria-hidden="true">{role.icon}</span>
                <div>
                  <p class="font-bold text-sm">{role.title[lang]}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[#9a9aa5]">{role.text[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="lg:col-span-2">
          <h2 class="text-xl font-bold" style={`color: ${app.accent};`}>
            {lang === 'en' ? 'By Task' : 'Por tarea'}
          </h2>
          <div class="mt-6 grid gap-6">
            {app.useCases.tasks.map((task) => (
              <div class="flex items-start gap-3">
                <span class="text-2xl shrink-0" aria-hidden="true">{task.icon}</span>
                <div>
                  <p class="font-bold text-sm">{task.title[lang]}</p>
                  <p class="mt-1 text-sm leading-relaxed text-[#9a9aa5]">{task.text[lang]}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Requirements & safety -->
    <section class="mt-12 card p-6 text-sm leading-relaxed">
      <h2 class="font-bold text-base">🪟 {lang === 'en' ? 'Requirements & safety' : 'Requisitos y seguridad'}</h2>
      <ul class="mt-3 space-y-1.5 text-[#c9c9d1]">
        <li>· Windows 10 / 11, 64-bit — {app.stack}</li>
        <li>· {lang === 'en' ? 'Installer, portable or' : 'Instalador, portable o'} <code class="px-1.5 py-0.5 rounded bg-white/5 border border-white/10 text-[#00f2ff] text-xs">winget install {app.winget ?? '<id>'}</code></li>
        <li>· 🔏 {lang === 'en' ? '“Unknown publisher” SmartScreen warning is expected (no paid certificate yet). Verify via release SHA / VirusTotal or build from source.' : 'Aviso SmartScreen de “editor desconocido” esperado (aún sin certificado de pago). Verifica con el SHA / VirusTotal o compilando.'}</li>
      </ul>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={downloadPath} class="font-semibold text-sm" style={`color: ${app.accent};`}>{lang === 'en' ? 'All install options →' : 'Todas las opciones →'}</a>
        <a href={faqPath} class="text-sm text-[#9a9aa5] hover:text-white transition-colors">FAQ →</a>
      </div>
    </section>

    <!-- Related apps -->
    <section class="mt-12">
      <h2 class="text-xl font-bold">{lang === 'en' ? 'Pairs well with' : 'Combina bien con'}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {related.map((r) => (
          <a href={lang === 'en' ? `/apps/${r.slug}` : `/es/apps/${r.slug}`} class="card p-4 block">
            <div class="text-3xl" aria-hidden="true">{r.emoji}</div>
            <p class="mt-2 font-bold text-sm">{r.name}</p>
            <p class="text-xs text-[#9a9aa5] truncate">{r.tagline[lang]}</p>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<script is:inline>
  // Resolve the "Download latest" buttons to the direct .exe asset of each
  // repo's latest GitHub release (asset names include the version, so the
  // static /releases/latest/download/<name> shortcut does not apply).
  // Falls back silently to the release page on API failure, and caches the
  // resolved URL for 10 minutes to stay well within the API rate limit.
  (function () {
    var TTL = 10 * 60 * 1000;

    function pickInstaller(assets) {
      var exe = (assets || []).filter(function (a) {
        return /\.exe$/i.test(a.name) && !/portable/i.test(a.name);
      });
      if (exe.length === 0) return null;
      return (
        exe.find(function (a) { return /setup|install/i.test(a.name); }) || exe[0]
      );
    }

    function resolveButton(btn) {
      var repo = btn.getAttribute('data-gh-repo');
      if (!repo) return;

      try {
        var cache = JSON.parse(localStorage.getItem('cg-rel-' + repo) || 'null');
        if (cache && cache.url && Date.now() - cache.ts < TTL) {
          btn.href = cache.url;
          showVersion(btn, cache.tag);
          return;
        }
      } catch (e) { /* ignore cache errors */ }

      fetch('https://api.github.com/repos/' + repo + '/releases/latest', {
        headers: { Accept: 'application/vnd.github+json' },
      })
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (release) {
          if (!release || !release.assets) return;
          var asset = pickInstaller(release.assets);
          if (!asset) return;
          btn.href = asset.browser_download_url;
          showVersion(btn, release.tag_name);
          try {
            localStorage.setItem(
              'cg-rel-' + repo,
              JSON.stringify({ url: asset.browser_download_url, tag: release.tag_name, ts: Date.now() })
            );
          } catch (e) { /* storage unavailable */ }
        })
        .catch(function () { /* keep the release page as fallback */ });
    }

    function showVersion(btn, tag) {
      var span = btn.querySelector('[data-gh-version]');
      if (span && tag) span.textContent = ' · ' + tag;
    }

    document.querySelectorAll('a[data-gh-repo]').forEach(resolveButton);
  })();
</script>
