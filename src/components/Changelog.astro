---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Lang } from '../data/ui';
import { fetchAllReleases } from '../data/releases';
import { wrapTables, sanitize } from '../data/docs';
import { marked } from 'marked';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const path = lang === 'en' ? '/changelog' : '/es/changelog';
const homeHref = lang === 'en' ? '/' : '/es/';
const title = lang === 'en' ? 'Changelog — CyberGems' : 'Novedades — CyberGems';
const description = lang === 'en'
  ? 'Latest releases across the CyberGems suite — changelogs for all 10 Windows apps, synced from GitHub.'
  : 'Últimos lanzamientos de la suite CyberGems — novedades de las 10 apps Windows, sincronizadas desde GitHub.';
const locale = lang === 'es' ? 'es-ES' : 'en-US';

const { apps: appsReleases, failed } = await fetchAllReleases();
const withReleases = appsReleases.filter((a) => a.releases.length > 0);
const pageSize = 10;
const releaseFeed = withReleases
  .flatMap((app) => app.releases.map((release) => ({ app, release })))
  .sort((a, b) => (Date.parse(b.release.publishedAt) || 0) - (Date.parse(a.release.publishedAt) || 0));

const fmtDate = (iso: string) =>
  iso
    ? new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })
    : '';

const renderNotes = (body: string) => {
  const raw = marked.parse(body) as string;
  // Downgrade stray h1 to h2 to preserve single h1 per page
  return raw.replace(/<h1(\s|>)/g, '<h2$1').replace(/<\/h1>/g, '</h2>');
};
const summarizeNotes = (body: string) => {
  const plain = body
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/<[^>]+>/g, ' ')
    .replace(/^[#>*+\-\d.\s]+/gm, '')
    .replace(/[*_~`|]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  return plain.length > 220 ? `${plain.slice(0, 217).trimEnd()}...` : plain;
};
const releaseId = (slug: string, tag: string, index: number) =>
  `release-${slug}-${tag.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${index}`;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://cybergems.org${lang === 'es' ? '/es/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: t.navChangelog, item: `https://cybergems.org${path}/` },
  ],
};
---

<BaseLayout title={title} description={description} lang={lang} path={path} ogImage={lang === 'es' ? '/og/es.png' : '/og.png'} jsonLd={breadcrumbLd}>
  <div
    class="max-w-4xl mx-auto px-5 pt-16 pb-24"
    data-release-browser
    data-page-size={String(pageSize)}
    data-showing-template={t.changelogShowing}
  >
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight">
        <span class="text-gradient brand-glow">{t.changelogTitle}</span>
      </h1>
      <p class="mt-4 max-w-2xl mx-auto text-[#9a9aa5] leading-relaxed">{t.changelogSubtitle}</p>
    </header>

    {failed && (
      <div class="mt-8 rounded-xl border border-[#FFB74D]/40 bg-[#FFB74D]/10 text-[#FFD8A8] text-sm p-4 text-center">
        ⚠ {t.changelogError}
      </div>
    )}

    <section class="mt-12" aria-labelledby="latest-releases-title">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h2 id="latest-releases-title" class="text-2xl font-bold tracking-tight">{t.changelogLatest}</h2>
          <p class="mt-1 text-xs text-[#9a9aa5]" data-release-count aria-live="polite">
            {t.changelogShowing
              .replace('{visible}', String(Math.min(pageSize, releaseFeed.length)))
              .replace('{total}', String(releaseFeed.length))}
          </p>
        </div>
      </div>

      <div class="release-filter-shell sticky top-16 z-30 mt-5 -mx-2 px-2 py-3">
        <p class="mb-2 px-1 text-[11px] font-bold uppercase tracking-[0.14em] text-white/50">{t.changelogFilter}</p>
        <nav aria-label={t.changelogFilter} class="release-filter-list flex gap-2 overflow-x-auto pb-1">
          <button type="button" class="release-filter" data-release-filter="all" aria-pressed="true">
            <span class="filter-all-icon" aria-hidden="true">✦</span>
            {t.changelogAll}
          </button>
          {withReleases.map((app) => (
            <button type="button" class="release-filter" data-release-filter={app.slug} aria-pressed="false">
              {app.icon
                ? <img src={app.icon} alt="" width="18" height="18" class="h-[18px] w-[18px] object-contain" />
                : <span aria-hidden="true">{app.emoji}</span>}
              {app.name}
            </button>
          ))}
        </nav>
      </div>

      <div class="mt-6 space-y-4" data-release-list>
        {releaseFeed.map(({ app, release }, index) => {
          const headingId = releaseId(app.slug, release.tag, index);
          const summary = summarizeNotes(release.body);
          return (
            <article
              class="card release-card p-5 sm:p-6"
              data-release-card
              data-app={app.slug}
              hidden={index >= pageSize}
              aria-labelledby={headingId}
            >
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div class="flex min-w-0 items-start gap-3.5">
                  <div class="release-app-icon" aria-hidden="true">
                    {app.icon
                      ? <img src={app.icon} alt="" width="34" height="34" class="h-[34px] w-[34px] object-contain" />
                      : <span class="text-xl">{app.emoji}</span>}
                  </div>
                  <div class="min-w-0">
                    <p class="text-xs font-semibold text-[#00f2ff]">{app.name}</p>
                    <h3 id={headingId} class="mt-1 font-semibold text-white leading-snug">{release.name}</h3>
                  </div>
                </div>
                <div class="flex shrink-0 items-center gap-2 sm:flex-col sm:items-end">
                  <span class="rounded-md border border-[#00f2ff]/25 bg-[#00f2ff]/[0.08] px-2.5 py-1 text-xs font-bold text-[#00f2ff]">
                    {release.tag}
                  </span>
                  <time class="text-xs text-[#9a9aa5]" datetime={release.publishedAt}>{fmtDate(release.publishedAt)}</time>
                </div>
              </div>

              {summary && <p class="mt-4 text-sm leading-relaxed text-[#b4b4bf]">{summary}</p>}

              {release.body && (
                <details class="release-details mt-4">
                  <summary>
                    <span class="details-closed">{t.changelogExpand}</span>
                    <span class="details-open">{t.changelogCollapse}</span>
                    <span class="details-chevron" aria-hidden="true">⌄</span>
                  </summary>
                  <div class="release-notes mt-4 border-t border-white/[0.08] pt-4 text-sm text-[#c9c9d1] leading-relaxed" set:html={sanitize(wrapTables(renderNotes(release.body)))} />
                </details>
              )}

              <a
                href={release.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-flex text-xs font-semibold text-[#00f2ff] hover:text-white hover:underline underline-offset-4 transition-colors"
              >
                {t.viewOnGitHub} ↗
              </a>
            </article>
          );
        })}
      </div>

      <div class="mt-8 flex justify-center">
        <button
          type="button"
          class="btn-ghost text-sm"
          data-release-more
          hidden={releaseFeed.length <= pageSize}
        >
          {t.changelogShowMore}
        </button>
      </div>
    </section>
  </div>

  <button type="button" class="back-to-top" data-back-to-top aria-label={t.backToTop} title={t.backToTop}>
    <span class="text-lg leading-none" aria-hidden="true">↑</span>
    <span class="hidden sm:inline">{t.backToTop}</span>
  </button>
</BaseLayout>

<script>
  const releaseBrowser = document.querySelector<HTMLElement>('[data-release-browser]');

  if (releaseBrowser) {
    const cards = Array.from(releaseBrowser.querySelectorAll<HTMLElement>('[data-release-card]'));
    const filters = Array.from(releaseBrowser.querySelectorAll<HTMLButtonElement>('[data-release-filter]'));
    const count = releaseBrowser.querySelector<HTMLElement>('[data-release-count]');
    const showMore = releaseBrowser.querySelector<HTMLButtonElement>('[data-release-more]');
    const pageSize = Number(releaseBrowser.dataset.pageSize) || 10;
    const showingTemplate = releaseBrowser.dataset.showingTemplate || '{visible} / {total}';
    const hashFilter = decodeURIComponent(window.location.hash.slice(1));
    let activeFilter = filters.some((button) => button.dataset.releaseFilter === hashFilter) ? hashFilter : 'all';
    let visibleLimit = pageSize;

    const updateReleases = () => {
      const matches = cards.filter((card) => activeFilter === 'all' || card.dataset.app === activeFilter);

      cards.forEach((card) => { card.hidden = true; });
      matches.slice(0, visibleLimit).forEach((card) => { card.hidden = false; });
      filters.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.releaseFilter === activeFilter));
      });

      const visible = Math.min(visibleLimit, matches.length);
      if (count) {
        count.textContent = showingTemplate
          .replace('{visible}', String(visible))
          .replace('{total}', String(matches.length));
      }
      if (showMore) showMore.hidden = visible >= matches.length;
    };

    filters.forEach((button) => {
      button.addEventListener('click', () => {
        activeFilter = button.dataset.releaseFilter || 'all';
        visibleLimit = pageSize;
        const hash = activeFilter === 'all' ? '' : `#${activeFilter}`;
        window.history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`);
        updateReleases();
      });
    });

    showMore?.addEventListener('click', () => {
      visibleLimit += pageSize;
      updateReleases();
    });

    updateReleases();
  }

  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (backToTop) {
    const updateBackToTop = () => backToTop.classList.toggle('is-visible', window.scrollY > 700);
    backToTop.addEventListener('click', () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    });
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    updateBackToTop();
  }
</script>

<style>
  .release-filter-shell {
    background: linear-gradient(180deg, rgba(13, 15, 23, 0.98), rgba(13, 15, 23, 0.9));
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(14px);
  }

  .release-filter-list {
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 242, 255, 0.28) transparent;
  }

  .release-filter {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.2rem;
    padding: 0.4rem 0.72rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.025);
    color: #9a9aa5;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }

  .release-filter:hover {
    border-color: rgba(0, 242, 255, 0.45);
    color: #fff;
  }

  .release-filter[aria-pressed='true'] {
    border-color: rgba(0, 242, 255, 0.55);
    background: rgba(0, 242, 255, 0.09);
    color: #fff;
    box-shadow: 0 0 16px rgba(0, 242, 255, 0.08);
  }

  .filter-all-icon {
    color: #00f2ff;
  }

  .release-app-icon {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(0, 242, 255, 0.18);
    border-radius: 0.75rem;
    background: rgba(0, 242, 255, 0.045);
  }

  .release-details summary {
    display: inline-flex;
    cursor: pointer;
    list-style: none;
    align-items: center;
    gap: 0.35rem;
    color: #c9c9d1;
    font-size: 0.75rem;
    font-weight: 700;
    transition: color 160ms ease;
  }

  .release-details summary::-webkit-details-marker {
    display: none;
  }

  .release-details summary:hover {
    color: #fff;
  }

  .details-open {
    display: none;
  }

  .release-details[open] .details-closed {
    display: none;
  }

  .release-details[open] .details-open {
    display: inline;
  }

  .details-chevron {
    color: #00f2ff;
    font-size: 1rem;
    transition: transform 160ms ease;
  }

  .release-details[open] .details-chevron {
    transform: rotate(180deg);
  }

  .back-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    justify-content: center;
    padding: 0.65rem 0.8rem;
    border: 1px solid rgba(0, 242, 255, 0.3);
    border-radius: 9999px;
    background: rgba(13, 15, 23, 0.9);
    color: #dffcff;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(12px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(0.5rem);
    pointer-events: none;
    transition: opacity 180ms ease, visibility 180ms ease, transform 180ms ease, border-color 180ms ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover {
    border-color: rgba(0, 242, 255, 0.7);
  }
</style>
