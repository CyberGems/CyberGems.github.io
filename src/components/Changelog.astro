---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, type Lang } from '../data/ui';
import { fetchAllReleases } from '../data/releases';
import { wrapTables } from '../data/docs';
import { marked } from 'marked';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const path = lang === 'en' ? '/changelog' : '/es/changelog';
const homeHref = lang === 'en' ? '/' : '/es/';
const title = lang === 'en' ? 'Changelog — CyberGems' : 'Novedades — CyberGems';
const description = lang === 'en'
  ? 'Latest releases across the CyberGems suite — changelogs for all 10 Windows apps, synced from GitHub.'
  : 'Últimos lanzamientos de la suite CyberGems — novedades de las 10 apps Windows, sincronizadas desde GitHub.';
const locale = lang === 'es' ? 'es-ES' : 'en-US';

const { apps: appsReleases, failed } = await fetchAllReleases();
const withReleases = appsReleases.filter((a) => a.releases.length > 0);

const fmtDate = (iso: string) =>
  iso
    ? new Date(iso).toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' })
    : '';

const renderNotes = (body: string) => {
  const raw = marked.parse(body) as string;
  // Downgrade stray h1 to h2 to preserve single h1 per page
  return raw.replace(/<h1(\s|>)/g, '<h2$1').replace(/<\/h1>/g, '</h2>');
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `https://cybergems.org${lang === 'es' ? '/es/' : '/'}` },
    { '@type': 'ListItem', position: 2, name: t.navChangelog, item: `https://cybergems.org${path}/` },
  ],
};
---

<BaseLayout title={title} description={description} lang={lang} path={path} ogImage="/og.png" jsonLd={breadcrumbLd}>
  <div class="max-w-4xl mx-auto px-5 pt-16">
    <header class="text-center">
      <h1 class="text-4xl font-extrabold tracking-tight">
        <span class="text-gradient brand-glow">{t.changelogTitle}</span>
      </h1>
      <p class="mt-4 text-[#9a9aa5]">{t.changelogSubtitle}</p>
    </header>

    {failed && (
      <div class="mt-8 rounded-xl border border-[#FFB74D]/40 bg-[#FFB74D]/10 text-[#FFD8A8] text-sm p-4 text-center">
        ⚠ {t.changelogError}
      </div>
    )}

    <!-- App quick nav -->
    <nav aria-label="Changelog apps" class="mt-10 flex flex-wrap justify-center gap-2">
      {withReleases.map((app) => (
        <a href={`#${app.slug}`} class="chip hover:border-[#00f2ff] hover:text-white transition-colors">
          <span aria-hidden="true">{app.emoji}</span> {app.name}
        </a>
      ))}
    </nav>

    {withReleases.map((app) => (
      <section id={app.slug} class="mt-16 scroll-mt-20">
        <div class="flex items-center gap-3">
          <div
            class="w-11 h-11 rounded-xl flex items-center justify-center text-2xl border border-white/10"
            style={`background: radial-gradient(120% 120% at 20% 0%, ${app.accent}33 0%, transparent 60%);`}
            aria-hidden="true"
          >
            {app.emoji}
          </div>
          <h2 class="text-2xl font-bold tracking-tight">{app.name}</h2>
        </div>

        <div class="mt-6 space-y-4">
          {app.releases.map((rel) => (
            <article class="card p-5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-3">
                  <span
                    class="text-xs font-bold px-2.5 py-1 rounded-md"
                    style={`color: ${app.accent}; background: ${app.accent}14; border: 1px solid ${app.accent}40;`}
                  >
                    {rel.tag}
                  </span>
                  <h3 class="font-semibold">{rel.name}</h3>
                </div>
                <time class="text-xs text-[#9a9aa5]">{fmtDate(rel.publishedAt)}</time>
              </div>

              {rel.body && (
                <div class="release-notes mt-4 text-sm text-[#c9c9d1] leading-relaxed" set:html={wrapTables(renderNotes(rel.body))} />
              )}

              <a
                href={rel.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-xs font-semibold hover:underline"
                style={`color: ${app.accent};`}
              >
                {t.viewOnGitHub} ↗
              </a>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
