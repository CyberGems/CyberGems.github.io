---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'shield-check' && <>
    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" />
    <path d="m9 12 2 2 4-4" />
  </>}
  {name === 'list-checks' && <>
    <path d="m3 7 1.5 1.5L7 6" /><path d="M10 7h11" />
    <path d="m3 17 1.5 1.5L7 16" /><path d="M10 17h11" />
    <path d="M10 12h8" />
  </>}
  {name === 'activity' && <>
    <path d="M3 12h4l3-7 4 14 3-7h4" />
  </>}
  {name === 'sources' && <>
    <rect x="3" y="4" width="14" height="13" rx="2" /><path d="M7 8h6M7 12h4M20 8v11a2 2 0 0 1-2 2H8" />
  </>}
  {name === 'book-open' && <>
    <path d="M12 5c-3-2-7-2-10-1v15c3-1 7-1 10 1 3-2 7-2 10-1V4c-3-1-7-1-10 1ZM12 5v15" />
  </>}
  {name === 'database' && <>
    <ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3" />
  </>}
  {name === 'search' && <>
    <circle cx="10.5" cy="10.5" r="7.5" /><path d="m16 16 6 6" />
  </>}
  {name === 'keyboard' && <>
    <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M6 9h2M11 9h2M16 9h2M6 13h2M11 13h2M16 13h2M7 16h10" />
  </>}
  {name === 'grid' && <>
    <rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" />
  </>}
  {name === 'image' && <>
    <rect x="2" y="3" width="20" height="18" rx="2" /><circle cx="8" cy="9" r="2" /><path d="m4 18 6-6 4 3 3-2 5 5" />
  </>}
  {name === 'folder' && <>
    <path d="M3 6a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6Z" /><path d="M3 10h18" />
  </>}
  {name === 'sliders' && <>
    <path d="M4 6h8M17 6h3M4 12h3M12 12h8M4 18h10M19 18h1" /><circle cx="14.5" cy="6" r="2" /><circle cx="9.5" cy="12" r="2" /><circle cx="16.5" cy="18" r="2" />
  </>}
</svg>
