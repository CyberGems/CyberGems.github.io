---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../data/ui';
import { site } from '../data/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const title = en ? 'Donate — Support CyberGems' : 'Donar — Apoya CyberGems';
const description = en
  ? 'CyberGems is free forever with no ads or tracking. Support via GitHub Sponsors, PayPal, Ko-fi, Buy Me a Coffee or crypto.'
  : 'CyberGems es gratis para siempre, sin anuncios ni rastreo. Apoya vía GitHub Sponsors, PayPal, Ko-fi, Buy Me a Coffee o crypto.';
const path = en ? '/donate' : '/es/donate';
const hasFiduciary = site.paypal || site.kofi || site.bmc;
---

<BaseLayout title={title} description={description} lang={lang} path={path}>
  <div class="max-w-3xl mx-auto px-5 pt-16 pb-4 text-center">
    <span class="chip mb-4">♥ {en ? 'Free forever — supported by users' : 'Gratis para siempre — sostenido por usuarios'}</span>
    <h1 class="text-4xl font-extrabold tracking-tight">
      <span class="text-gradient brand-glow">{en ? 'If it saves you time daily, fuel it.' : 'Si te ahorra tiempo a diario, impúlsalo.'}</span>
    </h1>
    <p class="mt-4 text-[#9a9aa5] text-lg leading-relaxed">
      {en
        ? '10 native Windows apps, hundreds of hours each, no ads, no telemetry, no paywalls. Donations keep the project independent and the releases coming.'
        : '10 apps nativas Windows, cientos de horas cada una, sin anuncios, sin telemetría, sin muros de pago. Las donaciones mantienen el proyecto independiente y los lanzamientos en marcha.'}
    </p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 text-left">
      <a href={site.sponsors} target="_blank" rel="noopener noreferrer" class="card p-6 block">
        <div class="text-3xl" aria-hidden="true">💜</div>
        <h2 class="mt-3 text-lg font-bold">GitHub Sponsors <span class="text-xs font-semibold text-[#00f2ff] ml-1">{en ? 'RECOMMENDED' : 'RECOMENDADO'}</span></h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">
          {en ? 'Recurring or one-time, 0 fees, integrated with the repos you already use.' : 'Recurrente o puntual, 0 comisiones, integrado con los repos que ya usas.'}
        </p>
        <span class="mt-3 inline-block text-sm font-semibold text-[#00f2ff]">{en ? 'Sponsor →' : 'Apadrinar →'}</span>
      </a>
      <div class="card p-6">
        <div class="text-3xl" aria-hidden="true">⭐</div>
        <h2 class="mt-3 text-lg font-bold">{en ? 'Free ways to help' : 'Formas gratis de ayudar'}</h2>
        <ul class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed space-y-1">
          <li>{en ? '· Star the repos you use on GitHub' : '· Dale estrella en GitHub a los repos que uses'}</li>
          <li>{en ? '· Report bugs, suggest features, improve docs' : '· Reporta bugs, sugiere features, mejora docs'}</li>
          <li>{en ? '· Tell a friend / share your setup' : '· Cuéntaselo a un amigo / comparte tu setup'}</li>
        </ul>
        <a href={site.githubOrg} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm font-semibold text-[#00f2ff]">GitHub →</a>
      </div>
    </div>

    {hasFiduciary && (
      <section class="mt-6 card p-6 text-left">
        <h2 class="font-bold">{en ? 'One-time tips — official buttons' : 'Propinas puntuales — botones oficiales'}</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">
          {en
            ? 'Brand buttons that link straight to each platform. No third-party scripts on this site — your privacy promise stays intact.'
            : 'Botones de marca que enlazan directo a cada plataforma. Sin scripts de terceros en este sitio — tu promesa de privacidad intacta.'}
        </p>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
          {site.paypal && (
            <a href={site.paypal} target="_blank" rel="noopener noreferrer" aria-label="Donate via PayPal"
               class="inline-flex items-center gap-2 font-bold rounded-xl px-5 py-3 bg-[#FFC439] text-[#003087] hover:brightness-95 transition">
              <span class="italic font-extrabold">Pay<span class="text-[#0079C1]">Pal</span></span>
              <span class="text-sm">{en ? 'Donate' : 'Donar'}</span>
            </a>
          )}
          {site.kofi && (
            <a href={site.kofi} target="_blank" rel="noopener noreferrer" aria-label="Support on Ko-fi"
               class="inline-flex items-center gap-2 font-bold rounded-xl px-5 py-3 bg-[#FF5E5B] text-white hover:brightness-95 transition">
              <span aria-hidden="true">☕</span> Ko-fi
            </a>
          )}
          {site.bmc && (
            <a href={site.bmc} target="_blank" rel="noopener noreferrer" aria-label="Buy me a coffee"
               class="inline-flex items-center gap-2 font-bold rounded-xl px-5 py-3 bg-[#FFDD00] text-black hover:brightness-95 transition">
              <span aria-hidden="true">☕</span> Buy me a coffee
            </a>
          )}
        </div>
      </section>
    )}

    {site.crypto.length > 0 && (
      <section class="mt-6 card p-6 text-left">
        <h2 class="font-bold">🪙 Crypto</h2>
        <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">
          {en ? 'No fees, no account. Scan or copy — QR images are served locally, nothing leaks to third parties.' : 'Sin comisiones, sin cuenta. Escanea o copia — los QR se sirven en local, nada se filtra a terceros.'}
        </p>
        <p class="mt-2 text-xs text-[#FFB74D]">
          ⚠️ {en ? 'Send only the selected asset on the indicated network. Wrong network = permanent loss.' : 'Envía solo el activo indicado en la red indicada. Red equivocada = pérdida permanente.'}
        </p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {site.crypto.map((c) => (
            <div class="rounded-xl border border-white/10 p-4 bg-white/[0.02] text-center">
              <p class="font-bold text-sm flex items-center justify-center gap-2">
                {c.icon && <img src={c.icon} alt="" width="20" height="20" loading="lazy" decoding="async" class="w-5 h-5" aria-hidden="true" />}
                <span>{c.label} {c.network && <span class="ml-1 text-xs font-semibold text-[#9a9aa5]">{c.network}</span>}</span>
              </p>
              {c.qr && <img src={c.qr} alt={`${c.label} QR`} width="160" height="160" loading="lazy" decoding="async" class="mt-3 mx-auto w-40 h-40 rounded-lg border border-white/10 bg-white" />}
              <p class="mt-3 text-xs text-[#9a9aa5] break-all font-mono">{c.address}</p>
              <button type="button" data-copy={c.address} class="mt-2.5 text-xs font-semibold px-3 py-2 rounded-lg border border-white/10 hover:border-[#00f2ff] hover:text-white text-[#9a9aa5] transition-colors">
                {en ? 'Copy address' : 'Copiar dirección'}
              </button>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="mt-6 card p-6 text-left">
      <h2 class="font-bold">{en ? 'Where does the money go?' : '¿A dónde va el dinero?'}</h2>
      <ul class="mt-3 text-sm text-[#9a9aa5] leading-relaxed space-y-1.5">
        <li>{en ? '· 1. Development time — the scarcest resource in a one-man show.' : '· 1. Tiempo de desarrollo — el recurso más escaso en un one-man show.'}</li>
        <li>{en ? '· 2. Code-signing certificate — removes SmartScreen warnings.' : '· 2. Certificado de firma de código — elimina avisos de SmartScreen.'}</li>
        <li>{en ? '· 3. Hardware / test machines and domain costs.' : '· 3. Hardware / máquinas de prueba y costes del dominio.'}</li>
      </ul>
      <p class="mt-3 text-xs text-[#9a9aa5]">
        {en ? 'Note: donations never unlock features. Everything stays free and GPLv3 for everyone.' : 'Nota: donar nunca desbloquea funciones. Todo sigue gratis y GPLv3 para todos.'}
      </p>
      {!hasFiduciary && site.crypto.length === 0 && (
        <p class="mt-3 text-xs text-[#FFB74D]">
          {en
            ? 'Setup: add your PayPal / Ko-fi / BuyMeACoffee links and crypto addresses in src/data/site.ts — sections appear automatically.'
            : 'Setup: añade tus enlaces de PayPal / Ko-fi / BuyMeACoffee y direcciones crypto en src/data/site.ts — las secciones aparecen solas.'}
        </p>
      )}
    </div>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    document.querySelectorAll('button[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var addr = btn.getAttribute('data-copy') || '';
        var done = function () {
          var orig = btn.textContent;
          btn.textContent = '✓';
          setTimeout(function () { btn.textContent = orig; }, 1200);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(addr).then(done).catch(done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = addr;
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {}
          document.body.removeChild(ta);
          done();
        }
      });
    });
  })();
</script>
