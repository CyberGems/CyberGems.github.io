---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../data/ui';
import { site } from '../data/site';
import pagesData from '../data/pages.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const en = lang === 'en';
const c = (pagesData.about as Record<string, any>)[lang];
const path = en ? '/about' : '/es/about';
const toolGroups = [
  {
    title: en ? 'Development & AI' : 'Desarrollo e IA',
    icon: '</>',
    tools: [
      { name: 'Codex', mark: 'CX' },
      { name: 'Antigravity', mark: 'AG' },
      { name: 'VS Code', mark: '⌘' },
      { name: 'Cursor', mark: '↗' },
      { name: 'ZCode', mark: 'Z' },
      { name: 'Claude', mark: '✳' },
      { name: 'OpenCode', mark: 'OC' },
    ],
  },
  {
    title: en ? 'Visual & Creative' : 'Visual y creativo',
    icon: '✦',
    tools: [
      { name: 'Photoshop', mark: 'Ps' },
      { name: 'CorelDRAW', mark: 'CD' },
    ],
  },
];
---

<BaseLayout title={c.metaTitle} description={c.metaDesc} lang={lang} path={path}>
  <div class="max-w-4xl mx-auto px-5 pt-16 pb-4">
    <header class="text-center">
      <span class="chip mb-4">{c.badge}</span>
      <h1 class="text-4xl font-extrabold tracking-tight">
        <span class="text-gradient brand-glow">{c.title}</span>
      </h1>
      <p class="mt-4 text-[#9a9aa5] text-lg leading-relaxed max-w-2xl mx-auto">{c.intro}</p>
    </header>

    <section class="mt-12 card p-6 sm:p-8">
      <h2 class="text-xl font-bold">{c.isTitle}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 text-sm leading-relaxed">
        <div>
          <p class="font-semibold text-white">✓ {c.yesLabel}</p>
          <ul class="mt-2 space-y-1.5 text-[#c9c9d1]">
            {c.yesItems.map((item: string) => <li>· {item}</li>)}
          </ul>
        </div>
        <div>
          <p class="font-semibold text-white">✕ {c.noLabel}</p>
          <ul class="mt-2 space-y-1.5 text-[#c9c9d1]">
            {c.noItems.map((item: string) => <li>· {item}</li>)}
          </ul>
        </div>
      </div>
      <p class="mt-4 text-xs text-[#9a9aa5]">{c.privacyNote}</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold tracking-tight text-center">{c.principlesTitle}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {c.principles.map((p: any) => (
          <div class="card p-5">
            <div class="text-2xl" aria-hidden="true">{p.icon}</div>
            <h3 class="mt-3 font-bold">{p.t}</h3>
            <p class="mt-1.5 text-sm text-[#9a9aa5] leading-relaxed">{p.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mt-12">
      <header class="text-center">
        <span class="chip mb-4">🛠 {en ? 'The toolchain' : 'Herramientas de trabajo'}</span>
        <h2 class="text-2xl font-bold tracking-tight">Powered by</h2>
        <p class="mt-3 text-[#9a9aa5] max-w-2xl mx-auto">
          {en ? 'The tools behind the code, visuals and everyday craft of CyberGems.' : 'Las herramientas detrás del código, los visuales y el trabajo diario de CyberGems.'}
        </p>
      </header>

      <div class="mt-6 card p-5 sm:p-7">
        <div class="grid gap-8 lg:grid-cols-[1.55fr_1fr]">
          {toolGroups.map((group, index) => (
            <div class={index === 1 ? 'lg:border-l lg:border-white/10 lg:pl-8' : ''}>
              <div class="flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-white/10 bg-white/[0.04] text-sm font-extrabold text-[#00f2ff]" aria-hidden="true">{group.icon}</span>
                <h3 class="font-bold">{group.title}</h3>
              </div>
              <ul class="mt-4 grid grid-cols-2 gap-3 list-none m-0 p-0 sm:grid-cols-3 lg:grid-cols-2">
                {group.tools.map((tool) => (
                  <li class="flex min-w-0 items-center gap-3 rounded-xl border border-white/10 bg-white/[0.02] px-3 py-3">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 bg-white/[0.04] text-xs font-extrabold tracking-tight text-[#c9c9d1]" aria-hidden="true">{tool.mark}</span>
                    <span class="truncate text-sm font-semibold">{tool.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="mt-6 border-t border-white/10 pt-4 text-center text-xs text-[#9a9aa5]">
          {en ? 'Independent project — these are tools in the workflow, not sponsors or official partners.' : 'Proyecto independiente — son herramientas del flujo de trabajo, no patrocinadores ni socios oficiales.'}
        </p>
      </div>
    </section>

    <section class="mt-12 flex flex-wrap justify-center gap-3">
      <a href={en ? '/apps/cybersnap' : '/es/apps/cybersnap'} class="btn-primary">{c.exploreCta}</a>
      <a href={en ? '/donate' : '/es/donate'} class="btn-ghost">♥ {c.donateCta}</a>
      <a href={site.githubOrg} target="_blank" rel="noopener noreferrer" class="btn-ghost">GitHub ↗</a>
    </section>
  </div>
</BaseLayout>
