---
import type { CyberApp } from '../data/apps';
import type { Lang } from '../data/ui';
import type { LatestDownload } from '../data/releases';
import { appTask } from '../data/catalog';
import ReleaseDate from './ReleaseDate.astro';
import NavIcon from './NavIcon.astro';
interface Props { app: CyberApp; lang: Lang; download?: LatestDownload; }
const { app, lang, download } = Astro.props;
const task = appTask(app.slug);
const href = `${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`;
const downloadHref = download?.installer?.url || download?.releaseUrl || `${app.repo}/releases/latest`;
const downloadLabel = download?.installer?.url ? (lang === 'en' ? 'Download' : 'Descargar') : (lang === 'en' ? 'Latest release' : 'Última versión');
---
<article class="card app-card group min-w-0 flex flex-col" data-app-group={task.group} data-app-search={`${app.name} ${task.label[lang]} ${app.tagline[lang]}`}>
  <a href={href} class="flex flex-col flex-1 p-5">
    <div class="flex items-center gap-4">
      {app.icon && <img src={app.icon} alt="" width="64" height="64" class="h-16 w-16 shrink-0 object-contain" loading="lazy" decoding="async" />}
      <div class="min-w-0">
        <h3 class="text-xl font-bold">{app.name}</h3>
        <p class="mt-1 text-sm text-accent">{task.label[lang]}</p>
      </div>
    </div>
    <p class="mt-4 text-[15px] text-[var(--text-dim)] leading-relaxed flex-1">{app.tagline[lang]}</p>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-2 text-sm">
      <span class="font-semibold text-accent">{lang === 'en' ? 'Learn more' : 'Saber más'} <span aria-hidden="true">→</span></span>
      <span class="text-[var(--text-dim)]">Windows 10/11</span>
    </div>
  </a>
  <div class="mx-5 border-t border-white/10 pt-4 pb-5">
    <div class="mb-3 flex flex-wrap items-center gap-2 text-[13px]">
      {download?.tag && <span class="cg-badge cg-badge-ghost font-semibold">{download.tag}</span>}
      {download?.publishedAt && <ReleaseDate publishedAt={download.publishedAt} lang={lang} label={lang === 'en' ? 'Updated' : 'Actualizada'} />}
    </div>
    <a href={downloadHref} class="inline-flex min-h-11 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-bold text-primary-content bg-primary hover:brightness-95 transition" aria-label={`${downloadLabel} ${app.name}`}
      data-umami-event="download_click" data-umami-event-app={app.slug} data-umami-event-format="installer" data-umami-event-source="app-card" data-download-start>
      <NavIcon name="download" />{downloadLabel}
    </a>
  </div>
</article>
