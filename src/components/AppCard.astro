---
import type { CyberApp } from '../data/apps';
import type { Lang } from '../data/ui';
import type { LatestDownload } from '../data/releases';
import { appTask } from '../data/catalog';
import NavIcon from './NavIcon.astro';

interface Props {
  app: CyberApp;
  lang: Lang;
  download?: LatestDownload;
}

const { app, lang, download } = Astro.props;
const task = appTask(app.slug);
const href = `${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`;
const downloadHref = download?.installer?.url || download?.releaseUrl || `${app.repo}/releases/latest`;
const isInstaller = Boolean(download?.installer?.url);
const downloadLabel = isInstaller
  ? (lang === 'en' ? 'Download for Windows' : 'Descargar para Windows')
  : (lang === 'en' ? 'Latest release' : 'Última versión');

const formattedDate = download?.publishedAt
  ? new Date(download.publishedAt).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    })
  : null;
---

<article
  class="card app-card group relative min-w-0 flex flex-col overflow-hidden rounded-2xl border border-white/10 bg-[#12151f] hover:border-white/20 transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl hover:shadow-cyan-950/20"
  data-app-group={task.group}
  data-app-search={`${app.name} ${task.label[lang]} ${app.tagline[lang]} ${app.stack} ${app.license}`}
  style={`--app-accent: ${app.accent || '#00f2ff'};`}
>
  {/* Top subtle accent glow */}
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[2px] opacity-40 transition-opacity duration-300 group-hover:opacity-100"
    style="background: linear-gradient(90deg, transparent, var(--app-accent), transparent);"
    aria-hidden="true"
  />

  {/* Ambient background watermark icon */}
  {app.icon && (
    <div
      class="pointer-events-none absolute -right-6 -top-6 h-36 w-36 select-none opacity-[0.04] transition-all duration-500 group-hover:scale-105 group-hover:opacity-[0.08]"
      aria-hidden="true"
    >
      <img
        src={app.icon}
        alt=""
        width="144"
        height="144"
        class="h-full w-full object-contain filter grayscale"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  {/* Card body linking to app details */}
  <a href={href} class="flex flex-col flex-1 p-5 focus:outline-none focus-visible:ring-1 focus-visible:ring-accent rounded-t-2xl">
    {/* Micro-header */}
    <div class="flex items-center justify-between gap-2 text-xs font-mono tracking-wider">
      <div class="flex items-center gap-1.5 min-w-0">
        <span
          class="inline-block h-1.5 w-1.5 shrink-0 rounded-full"
          style="background-color: var(--app-accent); box-shadow: 0 0 8px var(--app-accent);"
          aria-hidden="true"
        />
        <span class="font-semibold uppercase tracking-wider text-[11px] text-accent/90 truncate">
          {task.label[lang]}
        </span>
      </div>
      {download?.tag && (
        <span class="shrink-0 rounded border border-white/10 bg-white/5 px-2 py-0.5 text-[11px] font-mono text-[var(--text-dim)]">
          {download.tag}
        </span>
      )}
    </div>

    {/* Identity header: icon + name */}
    <div class="mt-4 flex items-center gap-3.5">
      {app.icon && (
        <div class="relative flex h-14 w-14 shrink-0 items-center justify-center rounded-xl border border-white/10 bg-base-100/90 p-2 shadow-sm transition-colors group-hover:border-accent/40">
          <img
            src={app.icon}
            alt=""
            width="48"
            height="48"
            class="h-10 w-10 object-contain drop-shadow"
            loading="lazy"
            decoding="async"
          />
        </div>
      )}
      <div class="min-w-0 flex-1">
        <h3 class="text-xl font-bold tracking-tight text-white transition-colors group-hover:text-accent">
          {app.name}
        </h3>
        <p class="text-xs text-[var(--text-dim)]">{lang === 'en' ? 'Desktop App' : 'App de escritorio'}</p>
      </div>
    </div>

    {/* Description / tagline */}
    <p class="mt-3.5 text-[13.5px] leading-relaxed text-[var(--text-dim)] line-clamp-3 min-h-[3.75rem]">
      {app.tagline[lang]}
    </p>

    {/* Technical Specs Key-Value List */}
    <div class="mt-4 pt-3.5 border-t border-white/5 flex flex-col gap-2 text-xs">
      <div class="flex items-center justify-between gap-3">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
          {lang === 'en' ? 'Target' : 'Plataforma'}
        </span>
        <span class="font-medium text-white/90 text-right">
          Windows 10 / 11 · x64
        </span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
          {lang === 'en' ? 'Stack' : 'Tecnología'}
        </span>
        <span class="font-medium text-white/90 text-right truncate max-w-[62%]" title={app.stack}>
          {app.stack}
        </span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
          {lang === 'en' ? 'License' : 'Licencia'}
        </span>
        <span class="font-medium text-white/90 text-right">
          {app.license} · {lang === 'en' ? 'Open Source' : 'Código abierto'}
        </span>
      </div>
      <div class="flex items-center justify-between gap-3">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[var(--text-dim)] opacity-75">
          {lang === 'en' ? 'Updated' : 'Actualización'}
        </span>
        <span class="font-medium text-white/90 text-right font-mono text-[11px]">
          {formattedDate || download?.tag || (lang === 'en' ? 'Active' : 'Activo')}
        </span>
      </div>
    </div>
  </a>

  {/* Actions footer */}
  <div class="p-5 pt-3 border-t border-white/5 bg-white/[0.015] flex flex-col gap-2.5">
    <a
      href={downloadHref}
      class="flex w-full min-h-11 items-center justify-center gap-2 rounded-xl px-4 py-2 text-sm font-bold text-primary-content bg-primary hover:brightness-105 active:scale-[0.99] transition shadow-md shadow-primary/10"
      aria-label={`${downloadLabel} ${app.name}`}
      data-umami-event="download_click"
      data-umami-event-app={app.slug}
      data-umami-event-format="installer"
      data-umami-event-source="app-card"
      data-download-start
    >
      <NavIcon name="download" size={17} />
      <span>{downloadLabel}</span>
    </a>

    <div class="flex items-center justify-between text-xs px-0.5 pt-0.5 text-[var(--text-dim)]">
      <a
        href={href}
        class="font-medium text-accent hover:underline flex items-center gap-1 group/link"
      >
        <span>{lang === 'en' ? 'App details' : 'Detalles de la app'}</span>
        <span class="transition-transform group-hover/link:translate-x-0.5" aria-hidden="true">→</span>
      </a>

      {download?.portable?.url ? (
        <a
          href={download.portable.url}
          class="hover:text-white transition flex items-center gap-1 font-mono text-[11px]"
          data-umami-event="download_click"
          data-umami-event-app={app.slug}
          data-umami-event-format="portable"
          data-umami-event-source="app-card"
          data-download-start
        >
          <span>Portable (.zip)</span>
        </a>
      ) : (
        <a
          href={`${app.repo}/releases`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-white transition font-mono text-[11px]"
        >
          {lang === 'en' ? 'Releases' : 'Versiones'}
        </a>
      )}
    </div>
  </div>
</article>
