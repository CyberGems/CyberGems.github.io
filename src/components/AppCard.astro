---
import type { CyberApp } from '../data/apps';
import type { Lang } from '../data/ui';
import type { LatestDownload } from '../data/releases';
import { ui } from '../data/ui';

interface Props {
  app: CyberApp;
  lang: Lang;
  download?: LatestDownload;
}

const { app, lang, download } = Astro.props;
const t = ui[lang];
const href = lang === 'en' ? `/apps/${app.slug}` : `/es/apps/${app.slug}`;
const actionAccents: Record<string, string> = {
  cybersnap: '#F2A65A',
  cybermanager: '#82D6B0',
  cybertray: '#F0B35D',
  cyberfeeds: '#C792EA',
  cybernotes: '#81C784',
  cyberpaste: '#E8C86A',
  cyberwall: '#E57373',
  cyberviewer: '#BA68C8',
  cyberlauncher: '#8B9CF6',
  cyberclock: '#DDA15E',
};
const actionAccent = actionAccents[app.slug] ?? '#A8B3CF';
const learnMore = lang === 'en' ? 'Learn more' : 'Saber más';
const downloadHref = download?.installer?.url || download?.releaseUrl || `${app.repo}/releases/latest`;
const hasDirectInstaller = Boolean(download?.installer?.url);
const downloadLabel = hasDirectInstaller
  ? t.downloadCta
  : (lang === 'en' ? 'Latest release' : 'Última release');
const publishedDate = download?.publishedAt
  ? new Date(download.publishedAt).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<article class="card app-card group flex flex-col overflow-hidden" style={`--app-accent: ${app.accent}; --action-accent: ${actionAccent};`}>
  <!-- Visual tile: official app icon with an emoji fallback for older CMS entries -->
  <a href={href} class="flex flex-col flex-1">
    <div class="app-card-visual h-36 flex items-center justify-center relative overflow-hidden">
      <span class="app-card-logo-glow" aria-hidden="true"></span>
      {app.icon ? (
        <img
          src={app.icon}
          alt=""
          width="96"
          height="96"
          class="h-24 w-24 object-contain group-hover:scale-110 transition-transform duration-300"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <span aria-hidden="true" class="text-6xl group-hover:scale-110 transition-transform duration-300">
          {app.emoji}
        </span>
      )}
    </div>

    <div class="p-5 flex flex-col gap-3 flex-1">
      <div class="flex items-center justify-between gap-2">
        <h3 class="text-lg font-bold">{app.name}</h3>
        <span class="text-[11px] text-[#9a9aa5] font-medium">{app.stack}</span>
      </div>
      <span
        class="inline-flex w-fit items-center gap-1.5 rounded-md border border-[#0078D4]/35 bg-[#0078D4]/10 px-2 py-1 text-[11px] font-semibold text-[#c9dff4]"
        aria-label="Compatible with Windows 10 and Windows 11"
      >
        <svg aria-hidden="true" viewBox="0 0 16 16" class="h-3.5 w-3.5 fill-[#4fc3f7]">
          <path d="M1 2.3 7 1.5v6H1V2.3Zm8-1.1 6-.8v7.1H9V1.2ZM1 8.5h6v6L1 13.7V8.5Zm8 0h6v7.1l-6-.8V8.5Z" />
        </svg>
        Windows 10/11
      </span>
      <p class="text-sm text-[#9a9aa5] leading-relaxed flex-1">{app.tagline[lang]}</p>
      <span class="text-sm font-semibold inline-flex items-center gap-1.5" style={`color: var(--action-accent);`}>
        {learnMore}
        <span class="inline-block group-hover:translate-x-1 transition-transform">→</span>
      </span>
    </div>
  </a>

  <div class="px-5 pb-5 pt-1">
    {(download?.tag || publishedDate) && (
      <div class="flex flex-wrap items-center gap-2 text-[11px] text-[#9a9aa5]">
        {download?.tag && (
          <span class="font-bold px-2 py-0.5 rounded-md" style={`color: var(--action-accent); background: ${actionAccent}14; border: 1px solid ${actionAccent}40;`}>
            {download.tag}
          </span>
        )}
        {publishedDate && <time datetime={download?.publishedAt}>{lang === 'en' ? 'Updated' : 'Actualizada'} {publishedDate}</time>}
      </div>
    )}
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <a
        href={downloadHref}
        class="inline-flex items-center gap-1.5 rounded-lg px-3 py-2 text-xs font-bold text-[#0d0f17] hover:brightness-95 transition"
        style={`background: var(--action-accent);`}
        data-umami-event="download_click"
        data-umami-event-app={app.slug}
        data-umami-event-format="installer"
        data-umami-event-source="app-card"
        data-download-start
      >
        ↓ {downloadLabel}
      </a>
      <a href={`${app.repo}/releases`} target="_blank" rel="noopener noreferrer" class="text-xs text-[#9a9aa5] hover:text-white transition-colors">
        {t.releasesCta} ↗
      </a>
    </div>
  </div>
</article>

<style>
  .app-card-visual {
    isolation: isolate;
  }

  .app-card-logo-glow {
    position: absolute;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--app-accent) 20%, transparent) 0%, transparent 70%);
    filter: blur(16px);
    opacity: 0.75;
    transform: scale(1.08);
    transition: opacity 220ms ease, transform 220ms ease;
    pointer-events: none;
    z-index: 0;
  }

  .app-card-visual > :not(.app-card-logo-glow) {
    position: relative;
    z-index: 1;
  }

  .app-card:hover .app-card-logo-glow,
  .app-card:focus-within .app-card-logo-glow {
    opacity: 0.95;
    transform: scale(1.18);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card-logo-glow { transition: none; }
  }
</style>
