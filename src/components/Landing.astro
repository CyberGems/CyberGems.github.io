---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from './AppCard.astro';
import FeatureSymbol from './FeatureSymbol.astro';
import NavIcon from './NavIcon.astro';
import Starfield from './Starfield.astro';
import { apps } from '../data/apps';
import { catalogGroups } from '../data/catalog';
import { ui, type Lang } from '../data/ui';
import { fetchLatestDownloads } from '../data/releases';
import pagesData from '../data/pages.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const { downloads } = await fetchLatestDownloads();
const homePath = lang === 'en' ? '/' : '/es/';
const title = lang === 'en' ? 'CyberGems: Free & open-source Windows apps' : 'CyberGems: Apps gratuitas y de código abierto para Windows';
const description = lang === 'en'
  ? `${apps.length} free, open-source Windows apps for screen capture, clipboard history, notes, security and more. No ads or account required.`
  : `${apps.length} apps gratuitas y de código abierto para Windows: capturas, portapapeles, notas, seguridad y más. Sin anuncios ni cuenta.`;
const strip = [
  { icon: 'gift', label: t.stripFree },
  { icon: 'ban', label: t.stripNoAds },
  { icon: 'user', label: t.stripNoAccount },
  { icon: 'shield-check', label: t.stripNoTrack },
  { icon: 'book-open', label: t.stripOss },
];
const principles = pagesData.about[lang].principles;
const principleIcons = ['shield-check', 'database', 'book-open', 'gift', 'activity', 'sliders'];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'CyberGems', url: 'https://cybergems.org', logo: 'https://cybergems.org/favicon.svg', sameAs: ['https://github.com/CyberGems'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'CyberGems', url: 'https://cybergems.org', inLanguage: lang, description },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: t.appsTitle,
    itemListElement: apps.map((app, i) => ({
      '@type': 'SoftwareApplication', position: i + 1, name: app.name,
      url: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`,
      applicationCategory: 'UtilitiesApplication', operatingSystem: 'Windows 10, Windows 11',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang={lang} path={homePath} ogImage={lang === 'es' ? '/og/es.png' : '/og.png'} jsonLd={jsonLd}>
  <section class="landing-hero relative overflow-hidden" data-space-hero>
    <Starfield />
    <div class="max-w-6xl mx-auto px-5 pt-10 sm:pt-14 text-center relative z-10">
      <span class="chip mb-5">{t.heroBadge}</span>
      <h1 class="hero-title mx-auto max-w-5xl text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
        {t.heroTitle1}<br /><span class="text-gradient">{t.heroTitle2}</span>
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-[var(--text-dim)] text-base sm:text-lg leading-relaxed">{t.heroText.replaceAll('{appCount}', String(apps.length))}</p>
      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#apps" class="btn-primary">{t.heroCta}<span aria-hidden="true">↓</span></a>
        <a href="https://github.com/CyberGems" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text-dim)] hover:text-white py-2">{t.heroCta2}<span aria-hidden="true"> ↗</span></a>
      </div>
      <div class="hero-stage-container mt-12 sm:mt-16" aria-hidden="true">
        <div class="hero-stage">
          <div class="hero-horizon">
            <div class="horizon-crest-glow"></div>
            <div class="horizon-inner-aurora"></div>
            <div class="horizon-rim-sweep"></div>
            <div class="horizon-rim-sweep horizon-rim-sweep--violet"></div>
            <div class="horizon-center-core">
              <div class="horizon-core-badge">
                <img src="/branding/cybergems-footer.svg" alt="" width="48" height="48" class="horizon-core-logo" />
              </div>
            </div>
          </div>
          <div class="hero-orbit">
            <div class="hero-orbit-track">
              {apps.map((app, index) => (
                <div class="hero-node" style={`--node-angle: ${index * 360 / apps.length}deg;`}>
                  <div class="hero-node-body">
                    <a href={lang === 'es' ? `/es/apps/${app.slug}/` : `/apps/${app.slug}/`} class="hero-node-link">
                      <span class="hero-node-icon">{app.icon ? <img src={app.icon} alt="" width="44" height="44" loading="eager" decoding="async" /> : app.emoji}</span>
                      <span class="hero-node-label">{app.name}</span>
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="border-y border-white/5 bg-base-200" aria-label={lang === 'en' ? 'Our commitments' : 'Nuestros compromisos'}>
    <ul class="max-w-6xl mx-auto px-5 py-4 grid grid-cols-2 sm:grid-cols-5 gap-3 list-none m-0">
      {strip.map((item, index) => (
        <li class:list={['flex items-center justify-center gap-2 text-sm text-[var(--text-dim)]', index === strip.length - 1 && 'col-span-2 sm:col-span-1']}>
          <span class="trust-icon"><FeatureSymbol name={item.icon} /></span><span>{item.label}</span>
        </li>
      ))}
    </ul>
  </section>
  <section id="apps" class="max-w-6xl mx-auto px-5 py-12 sm:py-16 scroll-mt-20">
    <div class="text-center mb-7">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{t.appsTitle}</h2>
      <p class="mt-3 text-[var(--text-dim)]">{t.appsSubtitle}</p>
    </div>
    <div data-catalog-controls hidden class="mb-7">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label={t.catalogFilter}>
          {catalogGroups.map((group) => (
            <button type="button" class="cg-btn cg-btn-sm min-h-11 font-medium" data-catalog-filter={group.id} aria-pressed={group.id === 'all'} aria-controls="catalog-grid">{group.label[lang]}</button>
          ))}
        </div>
        <input type="search" class="cg-input w-full lg:w-64 bg-base-100" aria-label={t.catalogSearch} placeholder={t.catalogSearch} data-catalog-search aria-controls="catalog-grid" />
      </div>
      <p class="mt-3 text-sm text-[var(--text-dim)]" data-catalog-count data-label={t.catalogCount} aria-live="polite" aria-atomic="true">{t.catalogCount.replace('{count}', String(apps.length))}</p>
    </div>
    <div id="catalog-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => <AppCard app={app} lang={lang} download={downloads[app.slug]} />)}
    </div>
    <p data-catalog-empty hidden class="py-10 text-center text-[var(--text-dim)]">{t.catalogEmpty}</p>
  </section>
  <section class="max-w-6xl mx-auto px-5 pb-8">
    <div class="text-center mb-8">
      <h2 class="text-3xl font-extrabold tracking-tight">{lang === 'en' ? 'Why CyberGems' : 'Por qué CyberGems'}</h2>
      <p class="mt-3 text-[var(--text-dim)]">{lang === 'en' ? 'Useful tools, with respect for your time and privacy.' : 'Herramientas útiles que respetan tu tiempo y tu privacidad.'}</p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {principles.map((principle, index) => (
        <div class="card p-5">
          <span class="inline-flex text-accent"><FeatureSymbol name={principleIcons[index]} /></span>
          <h3 class="mt-3 font-bold">{principle.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">{principle.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={lang === 'en' ? '/download' : '/es/download'} class="btn-ghost"><NavIcon name="download" />{lang === 'en' ? 'How to install' : 'Cómo instalar'}</a>
      <a href={lang === 'en' ? '/about' : '/es/about'} class="btn-ghost">{lang === 'en' ? 'Our story' : 'Nuestra historia'}</a>
      <a href={lang === 'en' ? '/faq' : '/es/faq'} class="btn-ghost">{lang === 'en' ? 'Common questions' : 'Preguntas frecuentes'}</a>
    </div>
  </section>
</BaseLayout>
<script>
  const controls = document.querySelector<HTMLElement>('[data-catalog-controls]');
  const search = document.querySelector<HTMLInputElement>('[data-catalog-search]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-catalog-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-app-group]');
  const count = document.querySelector<HTMLElement>('[data-catalog-count]');
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const normalize = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  let group = 'all';
  const filter = () => {
    const query = normalize(search?.value.trim() ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const matches = (group === 'all' || card.dataset.appGroup === group) && normalize(card.dataset.appSearch ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (count) count.textContent = (count.dataset.label ?? '{count}').replace('{count}', String(visible));
    if (empty) empty.hidden = visible > 0;
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    group = button.dataset.catalogFilter ?? 'all';
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    filter();
  }));
  search?.addEventListener('input', filter);
  if (controls) controls.hidden = false;
</script>
<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const track = document.querySelector('.hero-orbit-track');
    const bodies = document.querySelectorAll('.hero-node-body');
    if (!track || bodies.length === 0) return;

    let active = 0;
    const pause = () => {
      track.style.animationPlayState = 'paused';
      bodies.forEach((body) => (body.style.animationPlayState = 'paused'));
    };
    const resume = () => {
      track.style.animationPlayState = '';
      bodies.forEach((body) => (body.style.animationPlayState = ''));
    };

    // Detener la animación de los íconos solo cuando el puntero está sobre
    // un ícono (o su zona: ícono + etiqueta), no sobre el espacio vacío.
    bodies.forEach((body) => {
      body.addEventListener('mouseenter', () => {
        if (++active === 1) pause();
      });
      body.addEventListener('mouseleave', () => {
        if (--active === 0) resume();
      });
    });
  })();
</script>
<style>
  .landing-hero { isolation: isolate; background: var(--color-base-100); }
  [data-catalog-filter][aria-pressed="true"] { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 9%, var(--color-base-100)); color: var(--color-accent); }
  .trust-icon { display: inline-flex; flex-shrink: 0; color: var(--color-accent); }
  .trust-icon :global(svg) { width: 1rem; height: 1rem; }
  .hero-stage-container {
    --stage-height: 300px;
    --stage-headroom: 34px;
    --planet-radius: 500px;
    --planet-center-y: calc(600px + var(--stage-headroom));
    --orbit-gap: 40px;
    --node-size: 64px;
    position: relative;
    width: 100%;
    max-width: 1080px;
    margin-inline: auto;
    isolation: isolate;
  }
  .hero-stage {
    position: relative;
    width: 100%;
    height: calc(var(--stage-height) + var(--stage-headroom));
    margin-top: calc(-1 * var(--stage-headroom));
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }
  .hero-horizon {
    position: absolute;
    top: calc(var(--planet-center-y) - var(--planet-radius));
    left: 50%;
    width: calc(var(--planet-radius) * 2);
    height: calc(var(--planet-radius) * 2);
    transform: translateX(-50%);
    border-radius: 50%;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(circle at 50% 0%, #171f38 0%, #101426 32%, #0d0f17 72%);
    border: 2px solid #00f2ffd9;
    border-bottom: 1px solid transparent;
    box-shadow: 0 0 40px -8px #00f2ff66, 0 -16px 50px -4px #00f2ff73, 0 -45px 110px -15px #7a5cff66, inset 0 35px 70px -10px #00f2ff38, inset 0 1px 3px #ffffffb3;
    mask-image: linear-gradient(to bottom, black 0%, black 75%, transparent 95%);
  }
  .horizon-crest-glow {
    position: absolute;
    top: -4px;
    left: 20%;
    width: 60%;
    height: 35px;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 0%, #00f2ff8c, transparent 75%);
    filter: blur(8px);
  }
  .horizon-inner-aurora {
    position: absolute;
    top: 0;
    left: 15%;
    width: 70%;
    height: 40%;
    border-radius: 50%;
    background: radial-gradient(ellipse at 50% 0%, #7a5cff38, transparent 70%);
    filter: blur(20px);
  }
  .horizon-rim-sweep, .horizon-rim-sweep::before {
    position: absolute;
    inset: 0;
    border-radius: 50%;
  }
  .horizon-rim-sweep::before {
    content: '';
    background: conic-gradient(from 0deg, transparent 0deg, transparent 297deg, #00f2ff4d 338deg, #00f2ffd9 354deg, #00f2ff00 359deg);
    mask-image: radial-gradient(circle closest-side, transparent calc(100% - 5px), black calc(100% - 4px));
  }
  .horizon-rim-sweep::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 6px;
    height: 3px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, #ffffffe6 0%, #00f2ff99 45%, #00f2ff00 80%);
  }
  .horizon-rim-sweep--violet::before {
    background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, #7a5cff66 348deg, #7a5cffcc 355deg, #7a5cff00 359deg);
  }
  .horizon-rim-sweep--violet::after {
    width: 10px;
    height: 4px;
    background: radial-gradient(ellipse, #ebe4ff 0%, #9678ffe6 45%, #7a5cff00 80%);
  }
  .horizon-center-core {
    position: absolute;
    top: 70px;
    left: 50%;
    transform: translateX(-50%);
  }
  .horizon-core-badge {
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    border-radius: 1.4rem;
    background: radial-gradient(circle at 50% 32%, #1e2739f5, #0d0f17eb 72%);
    border: 1px solid #00f2ff4d;
    box-shadow: 0 10px 26px #0005, 0 0 22px #00f2ff1f, inset 0 1px 0 #ffffff14;
  }
  .horizon-core-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    transform: translateY(1px);
    filter: drop-shadow(0 0 8px #00f2ff33);
  }
  .hero-orbit {
    position: absolute;
    top: var(--planet-center-y);
    left: 50%;
    width: 0;
    height: 0;
    z-index: 4;
  }
  .hero-orbit-track, .hero-node {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
  }
  .hero-node {
    /* Use the original transform orbit with a shared planet radius.
       The angle is computed from the published app count, never a fixed slot size. */
    transform: rotate(var(--node-angle)) translateY(calc(-1 * (var(--planet-radius) + var(--orbit-gap)))) rotate(calc(-1 * var(--node-angle)));
  }
  .hero-node-body {
    position: relative;
    width: var(--node-size);
    height: var(--node-size);
    transform: translate(-50%, -50%);
  }
  .hero-node-icon {
    display: grid;
    place-items: center;
    width: var(--node-size);
    height: var(--node-size);
    border: 1.5px solid #ffffff24;
    border-radius: 50%;
    background: #101420e6;
    backdrop-filter: blur(10px);
    box-shadow: 0 8px 24px #0009, 0 0 12px #00f2ff1f;
    transition: transform 220ms ease, border-color 220ms, box-shadow 220ms;
  }
  .hero-node-icon img { width: 44px; height: 44px; object-fit: contain; filter: drop-shadow(0 0 8px #00f2ff40); }
  .hero-node-label {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.72rem;
    font-weight: 700;
    color: #fff;
    background: #0d0f17f0;
    border: 1px solid #ffffff24;
    padding: 2px 8px;
    border-radius: 9999px;
    white-space: nowrap;
    box-shadow: 0 4px 14px #000b;
    opacity: 0.88;
  }
  .hero-node-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  .hero-node:hover .hero-node-icon { transform: scale(1.12); border-color: #00f2ff; box-shadow: 0 10px 28px #000a, 0 0 17px #00f2ff85; }
  .hero-node:hover .hero-node-label { opacity: 1; color: #00f2ff; border-color: #00f2ff; }
  @media (max-width: 900px) {
    .hero-stage-container { --stage-height: 280px; --planet-radius: 410px; --planet-center-y: calc(520px + var(--stage-headroom)); --orbit-gap: 50px; }
  }
  @media (max-width: 600px) {
    .hero-stage-container { --stage-height: 230px; --planet-radius: 340px; --planet-center-y: calc(440px + var(--stage-headroom)); --orbit-gap: 50px; --node-size: 52px; }
    .hero-node-icon img { width: 34px; height: 34px; }
    .hero-node-label { font-size: 0.65rem; padding: 1px 6px; }
    .horizon-center-core { top: 54px; }
    .horizon-core-badge { width: 56px; height: 56px; }
    .horizon-core-logo { width: 38px; height: 38px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-orbit-track { animation: orbit-spin 48s linear infinite; }
    .hero-node-body { animation: orbit-counter-spin 48s linear infinite; }
    .horizon-rim-sweep { animation: rim-sweep 11s linear infinite; }
    .horizon-rim-sweep--violet { animation: rim-sweep 17s linear infinite reverse; }
  }
  @keyframes orbit-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes orbit-counter-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(-360deg); }
  }
  @keyframes rim-sweep {
    to { transform: rotate(360deg); }
  }
</style>
