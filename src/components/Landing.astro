---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from './AppCard.astro';
import { apps } from '../data/apps';
import { ui, type Lang } from '../data/ui';
import { fetchLatestDownloads } from '../data/releases';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const { downloads } = await fetchLatestDownloads();
const homePath = lang === 'en' ? '/' : '/es/';
const title = lang === 'en' ? 'CyberGems — Free & open-source Windows apps' : 'CyberGems — Apps gratuitas y de código abierto para Windows';
const description = lang === 'en'
  ? '10 free, open-source Windows apps — screen capture, clipboard, notes, firewall and more. No ads, no tracking, GPLv3.'
  : '10 apps gratuitas y open-source para Windows — captura, portapapeles, notas, firewall y más. Sin anuncios, sin rastreo, GPLv3.';
const strip = [
  { icon: '🎁', label: t.stripFree },
  { icon: '🚫', label: t.stripNoAds },
  { icon: '🔒', label: t.stripNoTrack },
  { icon: '📖', label: t.stripOss },
];
const showcasePositions = [
  [-365, -64], [-182, -112], [0, -126], [182, -112], [365, -64],
  [-315, 76], [-105, 112], [105, 112], [315, 76], [0, 156],
];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'CyberGems',
  url: 'https://cybergems.org',
  logo: 'https://cybergems.org/favicon.svg',
  sameAs: ['https://github.com/CyberGems'],
};
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CyberGems',
  url: 'https://cybergems.org',
  inLanguage: lang,
  description,
};
const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: t.appsTitle,
  itemListElement: apps.map((app, i) => ({
    '@type': 'SoftwareApplication',
    position: i + 1,
    name: app.name,
    url: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Windows 10, Windows 11',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })),
};
---

<BaseLayout title={title} description={description} lang={lang} path={homePath} ogImage={lang === 'es' ? '/og/es.png' : '/og.png'} jsonLd={[orgLd, websiteLd, itemListLd]}>
  <!-- Hero -->
  <section class="landing-hero relative overflow-hidden">
    <div class="hero-aura" aria-hidden="true"></div>
    <div class="hero-grid absolute inset-0 cyber-grid" aria-hidden="true"></div>
    <div class="hero-spotlight" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 pt-24 pb-20 text-center relative">
      <span class="hero-enter hero-badge chip mb-6">{t.heroBadge}</span>
      <h1 class="hero-enter hero-title text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
        {t.heroTitle1}<br />
        <span class="text-gradient brand-glow">{t.heroTitle2}</span>
      </h1>
      <p class="hero-enter hero-description mt-6 max-w-2xl mx-auto text-[#9a9aa5] text-lg leading-relaxed">{t.heroText}</p>
      <div class="hero-enter hero-actions mt-9 flex flex-wrap items-center justify-center gap-4">
        <a href="#apps" class="btn-primary">{t.heroCta} ↓</a>
        <a href="https://github.com/CyberGems" target="_blank" rel="noopener noreferrer" class="btn-ghost">
          ★ {t.heroCta2}
        </a>
      </div>
      <div class="hero-enter suite-showcase mt-16" style="--showcase-delay: 320ms;" aria-label={lang === 'en' ? 'CyberGems apps' : 'Apps de CyberGems'}>
        <div class="suite-showcase-ring suite-showcase-ring-one" aria-hidden="true"></div>
        <div class="suite-showcase-ring suite-showcase-ring-two" aria-hidden="true"></div>
        <div class="suite-showcase-core" aria-hidden="true">
          <img src="/favicon.svg" alt="" width="44" height="44" />
          <span>CyberGems</span>
        </div>
        <div class="suite-showcase-apps">
          {apps.map((app, index) => {
            const [x, y] = showcasePositions[index] ?? [0, 0];
            return (
              <a
                href={lang === 'en' ? `/apps/${app.slug}` : `/es/apps/${app.slug}`}
                class="suite-showcase-app"
                style={`--app-x: ${x}px; --app-y: ${y}px; --app-accent: ${app.accent}; --app-delay: ${index * 55}ms;`}
                aria-label={app.name}
              >
                <span class="suite-showcase-app-body">
                  <span class="suite-showcase-icon">
                    {app.icon ? <img src={app.icon} alt="" width="56" height="56" /> : <span aria-hidden="true">{app.emoji}</span>}
                  </span>
                  <span class="suite-showcase-name">{app.name}</span>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="border-y border-white/5 bg-[#12151f]" aria-label="Features">
    <ul class="max-w-6xl mx-auto px-5 py-5 grid grid-cols-2 sm:grid-cols-4 gap-4 list-none m-0 p-0">
      {strip.map((item) => (
        <li class="flex items-center justify-center gap-2 text-sm text-[#9a9aa5]">
          <span aria-hidden="true">{item.icon}</span>
          <span class="font-medium">{item.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Apps grid -->
  <section id="apps" class="max-w-6xl mx-auto px-5 py-20 scroll-mt-20">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{t.appsTitle}</h2>
      <p class="mt-3 text-[#9a9aa5]">{t.appsSubtitle}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => <AppCard app={app} lang={lang} download={downloads[app.slug]} />)}
    </div>
  </section>

  <!-- Principles (same 6 as /about) -->
  <section class="max-w-6xl mx-auto px-5 pb-20">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-extrabold tracking-tight">{lang === 'en' ? 'Why CyberGems' : 'Por qué CyberGems'}</h2>
      <p class="mt-3 text-[#9a9aa5]">{lang === 'en' ? 'Built for daily use, with the bloat removed.' : 'Hechas para el día a día, sin la grasa.'}</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { icon: '🔒', t: 'Privacy-first', d: lang === 'en' ? 'Your data never leaves your PC.' : 'Tus datos nunca salen de tu equipo.' },
        { icon: '💻', t: 'Local-first', d: lang === 'en' ? 'Offline. No accounts, no subscriptions.' : 'Offline. Sin cuentas ni suscripciones.' },
        { icon: '📖', t: lang === 'en' ? 'Open source' : 'Código abierto', d: 'GPLv3.' },
        { icon: '🎁', t: lang === 'en' ? '100% Free' : '100% Gratis', d: lang === 'en' ? 'No ads, no paywalls.' : 'Sin anuncios ni muros de pago.' },
        { icon: '⚡', t: lang === 'en' ? 'Fast & light' : 'Rápido y ligero', d: lang === 'en' ? 'Native desktop, no Electron.' : 'Nativo, sin Electron.' },
        { icon: '✨', t: lang === 'en' ? 'Sober design' : 'Diseño sobrio', d: lang === 'en' ? 'Clean, purposeful interfaces.' : 'Interfaces limpias y claras.' },
      ].map((p) => (
        <div class="card p-5">
          <div class="text-2xl" aria-hidden="true">{p.icon}</div>
          <h3 class="mt-2 font-bold">{p.t}</h3>
          <p class="mt-1 text-sm text-[#9a9aa5]">{p.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={lang === 'en' ? '/download' : '/es/download'} class="btn-primary">{lang === 'en' ? 'How to install' : 'Cómo instalar'}</a>
      <a href={lang === 'en' ? '/about' : '/es/about'} class="btn-ghost">{lang === 'en' ? 'Our story' : 'Nuestra historia'}</a>
      <a href={lang === 'en' ? '/faq' : '/es/faq'} class="btn-ghost">FAQ</a>
      <a href={lang === 'en' ? '/donate' : '/es/donate'} class="btn-ghost">♥ {lang === 'en' ? 'Donate' : 'Donar'}</a>
    </div>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>('.landing-hero');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const motion = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

  if (hero) {
    let frame = 0;
    let cursorX = 0;
    let cursorY = 0;

    const reset = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      hero.classList.remove('is-pointer-active');
      hero.style.setProperty('--grid-x', '0px');
      hero.style.setProperty('--grid-y', '0px');
    };

    hero.addEventListener('pointermove', (event) => {
      if (!canHover.matches || event.pointerType === 'touch') return;
      cursorX = event.clientX;
      cursorY = event.clientY;
      // Coalesce pointer events; no render loop runs while the cursor is idle.
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const bounds = hero.getBoundingClientRect();
        const x = cursorX - bounds.left;
        const y = cursorY - bounds.top;
        hero.style.setProperty('--cursor-x', `${x}px`);
        hero.style.setProperty('--cursor-y', `${y}px`);
        // Grid parallax is ambient motion: keep it behind reduced-motion.
        if (motion.matches) {
          hero.style.setProperty('--grid-x', `${(x / bounds.width - 0.5) * 20}px`);
          hero.style.setProperty('--grid-y', `${(y / bounds.height - 0.5) * 16}px`);
        }
        hero.classList.add('is-pointer-active');
      });
    }, { passive: true });

    hero.addEventListener('pointerleave', reset);
    hero.addEventListener('pointercancel', reset);
    window.addEventListener('blur', reset);
    window.addEventListener('scroll', reset, { passive: true });
    motion.addEventListener('change', reset);
    canHover.addEventListener('change', reset);
  }
</script>

<style>
  .landing-hero {
    isolation: isolate;
  }

  .hero-grid {
    inset: -12px;
    pointer-events: none;
  }

  .hero-spotlight {
    display: none;
    position: absolute;
    top: 0;
    left: 0;
    width: 440px;
    height: 440px;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(circle, rgb(0 242 255 / 0.16), rgb(122 92 255 / 0.09) 38%, transparent 70%);
    transform: translate(calc(var(--cursor-x, 0px) - 50%), calc(var(--cursor-y, 0px) - 50%));
  }

  /* Cursor halo follows the pointer (user-driven, not autonomous motion),
     so it is not gated behind reduced-motion. Grid parallax stays gated. */
  @media (hover: hover) and (pointer: fine) {
    .hero-spotlight {
      display: block;
      transition: opacity 250ms ease;
    }

    .is-pointer-active .hero-spotlight { opacity: 1; }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero-grid {
      transform: translate(var(--grid-x, 0px), var(--grid-y, 0px));
      transition: transform 350ms ease-out;
    }
  }

  /* Static gradients need no blur filter, images, or animation runtime. */
  .hero-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 42% 65% at 28% 35%, rgb(0 242 255 / 0.085), transparent 75%),
      radial-gradient(ellipse 42% 70% at 75% 45%, rgb(122 92 255 / 0.12), transparent 75%);
  }

  .landing-hero::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 15%;
    width: 70%;
    height: 1px;
    pointer-events: none;
    background: linear-gradient(90deg, transparent, rgb(0 242 255 / 0.3), rgb(122 92 255 / 0.3), transparent);
  }

  /* One-shot compositor-friendly motion; the page is still once settled.
     Content stays visible by default, including with reduced motion or no JS. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-enter {
      animation: hero-enter 700ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }

    .hero-title { animation-delay: 80ms; }
    .hero-description { animation-delay: 160ms; }
    .hero-actions { animation-delay: 240ms; }

    /* Reveal focused controls immediately during the entrance. */
    .hero-actions:focus-within { animation: none; }

    .hero-aura {
      animation: hero-aura-settle 2400ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
  }

  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes hero-aura-settle {
    from { opacity: 0; transform: translateY(16px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  .suite-showcase {
    position: relative;
    width: min(100%, 960px);
    height: 300px;
    margin-inline: auto;
    isolation: isolate;
  }

  .suite-showcase::before {
    content: '';
    position: absolute;
    inset: 24% 18% 6%;
    z-index: -1;
    background: radial-gradient(ellipse, rgb(0 242 255 / 0.13), transparent 68%);
    filter: blur(18px);
  }

  .suite-showcase-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgb(0 242 255 / 0.14);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-12deg);
  }

  .suite-showcase-ring-one { width: 360px; height: 180px; }
  .suite-showcase-ring-two { width: 610px; height: 230px; border-color: rgb(122 92 255 / 0.13); transform: translate(-50%, -50%) rotate(14deg); }

  .suite-showcase-core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: flex;
    width: 132px;
    height: 132px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    border: 1px solid rgb(0 242 255 / 0.32);
    border-radius: 2rem;
    background: linear-gradient(145deg, rgb(21 24 36 / 0.96), rgb(13 15 23 / 0.92));
    box-shadow: 0 0 55px rgb(0 242 255 / 0.16), inset 0 0 26px rgb(0 242 255 / 0.05);
    color: #fff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    transform: translate(-50%, -50%);
  }

  .suite-showcase-core img { width: 44px; height: 44px; }

  .suite-showcase-apps {
    position: absolute;
    inset: 0;
  }

  .suite-showcase-app {
    position: absolute;
    top: 50%;
    left: 50%;
    display: block;
    color: #c9c9d1;
    transform: translate(calc(-50% + var(--app-x)), calc(-50% + var(--app-y)));
  }

  .suite-showcase-app-body {
    display: flex;
    min-width: 94px;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    border-radius: 1rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.75);
    transition: color 180ms ease, transform 180ms ease;
    animation: suite-app-in 650ms cubic-bezier(0.22, 1, 0.36, 1) var(--app-delay) both;
  }

  .suite-showcase-icon {
    display: grid;
    width: 72px;
    height: 72px;
    place-items: center;
    background: transparent;
  }

  .suite-showcase-icon img { width: 72px; height: 72px; object-fit: contain; filter: drop-shadow(0 0 9px rgb(0 242 255 / 0.28)); transition: filter 180ms ease; }
  .suite-showcase-icon > span { font-size: 2.1rem; }

  .suite-showcase-app:hover .suite-showcase-app-body,
  .suite-showcase-app:focus-visible .suite-showcase-app-body {
    color: #fff;
    transform: translateY(-5px) scale(1.04);
  }

  .suite-showcase-app:hover .suite-showcase-icon img,
  .suite-showcase-app:focus-visible .suite-showcase-icon img {
    filter: drop-shadow(0 0 14px var(--app-accent));
  }

  @keyframes suite-app-in {
    from { opacity: 0; transform: scale(0.72); }
    to { opacity: 1; transform: scale(1); }
  }

  @media (max-width: 760px) {
    .suite-showcase {
      height: auto;
      margin-top: 3rem;
    }

    .suite-showcase-core,
    .suite-showcase-ring { display: none; }

    .suite-showcase-apps {
      position: relative;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.8rem;
    }

    .suite-showcase-app {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
    }

    .suite-showcase-app-body { min-width: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .suite-showcase-app-body { animation: none; }
  }
</style>
