---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppCard from './AppCard.astro';
import FeatureSymbol from './FeatureSymbol.astro';
import NavIcon from './NavIcon.astro';
import { apps } from '../data/apps';
import { catalogGroups } from '../data/catalog';
import { ui, type Lang } from '../data/ui';
import { fetchLatestDownloads } from '../data/releases';
import pagesData from '../data/pages.json';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = ui[lang];
const { downloads } = await fetchLatestDownloads();
const homePath = lang === 'en' ? '/' : '/es/';
const title = lang === 'en' ? 'CyberGems: Free & open-source Windows apps' : 'CyberGems: Apps gratuitas y de código abierto para Windows';
const description = lang === 'en'
  ? '11 free, open-source Windows apps for screen capture, clipboard history, notes, security and more. No ads or account required.'
  : '11 apps gratuitas y de código abierto para Windows: capturas, portapapeles, notas, seguridad y más. Sin anuncios ni cuenta.';
const strip = [
  { icon: 'gift', label: t.stripFree },
  { icon: 'ban', label: t.stripNoAds },
  { icon: 'user', label: t.stripNoAccount },
  { icon: 'shield-check', label: t.stripNoTrack },
  { icon: 'book-open', label: t.stripOss },
];
const principles = pagesData.about[lang].principles;
const principleIcons = ['shield-check', 'database', 'book-open', 'gift', 'activity', 'sliders'];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'CyberGems', url: 'https://cybergems.org', logo: 'https://cybergems.org/favicon.svg', sameAs: ['https://github.com/CyberGems'] },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'CyberGems', url: 'https://cybergems.org', inLanguage: lang, description },
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: t.appsTitle,
    itemListElement: apps.map((app, i) => ({
      '@type': 'SoftwareApplication', position: i + 1, name: app.name,
      url: `https://cybergems.org${lang === 'es' ? '/es' : ''}/apps/${app.slug}/`,
      applicationCategory: 'UtilitiesApplication', operatingSystem: 'Windows 10, Windows 11',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    })),
  },
];
---

<BaseLayout title={title} description={description} lang={lang} path={homePath} ogImage={lang === 'es' ? '/og/es.png' : '/og.png'} jsonLd={jsonLd}>
  <section class="landing-hero relative overflow-hidden">
    <div class="absolute inset-0 cyber-grid pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-6xl mx-auto px-5 pt-10 sm:pt-14 pb-10 sm:pb-0 text-center relative">
      <span class="chip mb-5">{t.heroBadge}</span>
      <h1 class="hero-title mx-auto max-w-5xl text-4xl sm:text-6xl font-extrabold tracking-tight leading-tight">
        {t.heroTitle1}<br /><span class="text-gradient">{t.heroTitle2}</span>
      </h1>
      <p class="mt-5 max-w-2xl mx-auto text-[var(--text-dim)] text-base sm:text-lg leading-relaxed">{t.heroText}</p>
      <div class="mt-7 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="#apps" class="btn-primary">{t.heroCta}<span aria-hidden="true">↓</span></a>
        <a href="https://github.com/CyberGems" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text-dim)] hover:text-white py-2">{t.heroCta2}<span aria-hidden="true"> ↗</span></a>
      </div>
      <div class="hero-stage hidden sm:block mt-6" aria-hidden="true">
        <div class="hero-horizon"></div>
        <img src="/branding/cybergems-footer.svg" alt="" width="48" height="48" class="hero-core" />
        <div class="hero-orbit">
          {apps.map((app, index) => (
            <div class="hero-node" style={`--angle: ${index * 36}deg;`}>
              <span class="hero-node-icon">{app.icon && <img src={app.icon} alt="" width="40" height="40" loading="eager" decoding="async" />}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="border-y border-white/5 bg-base-200" aria-label={lang === 'en' ? 'Our commitments' : 'Nuestros compromisos'}>
    <ul class="max-w-6xl mx-auto px-5 py-4 grid grid-cols-2 sm:grid-cols-5 gap-3 list-none m-0">
      {strip.map((item, index) => (
        <li class:list={['flex items-center justify-center gap-2 text-sm text-[var(--text-dim)]', index === strip.length - 1 && 'col-span-2 sm:col-span-1']}>
          <span class="trust-icon"><FeatureSymbol name={item.icon} /></span><span>{item.label}</span>
        </li>
      ))}
    </ul>
  </section>
  <section id="apps" class="max-w-6xl mx-auto px-5 py-12 sm:py-16 scroll-mt-20">
    <div class="text-center mb-7">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">{t.appsTitle}</h2>
      <p class="mt-3 text-[var(--text-dim)]">{t.appsSubtitle}</p>
    </div>
    <div data-catalog-controls hidden class="mb-7">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label={t.catalogFilter}>
          {catalogGroups.map((group) => (
            <button type="button" class="cg-btn cg-btn-sm min-h-11 font-medium" data-catalog-filter={group.id} aria-pressed={group.id === 'all'} aria-controls="catalog-grid">{group.label[lang]}</button>
          ))}
        </div>
        <input type="search" class="cg-input w-full lg:w-64 bg-base-100" aria-label={t.catalogSearch} placeholder={t.catalogSearch} data-catalog-search aria-controls="catalog-grid" />
      </div>
      <p class="mt-3 text-sm text-[var(--text-dim)]" data-catalog-count data-label={t.catalogCount} aria-live="polite" aria-atomic="true">{t.catalogCount.replace('{count}', String(apps.length))}</p>
    </div>
    <div id="catalog-grid" class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {apps.map((app) => <AppCard app={app} lang={lang} download={downloads[app.slug]} />)}
    </div>
    <p data-catalog-empty hidden class="py-10 text-center text-[var(--text-dim)]">{t.catalogEmpty}</p>
  </section>
  <section class="max-w-6xl mx-auto px-5 pb-8">
    <div class="text-center mb-8">
      <h2 class="text-3xl font-extrabold tracking-tight">{lang === 'en' ? 'Why CyberGems' : 'Por qué CyberGems'}</h2>
      <p class="mt-3 text-[var(--text-dim)]">{lang === 'en' ? 'Useful tools, with respect for your time and privacy.' : 'Herramientas útiles que respetan tu tiempo y tu privacidad.'}</p>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {principles.map((principle, index) => (
        <div class="card p-5">
          <span class="inline-flex text-accent"><FeatureSymbol name={principleIcons[index]} /></span>
          <h3 class="mt-3 font-bold">{principle.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">{principle.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={lang === 'en' ? '/download' : '/es/download'} class="btn-ghost"><NavIcon name="download" />{lang === 'en' ? 'How to install' : 'Cómo instalar'}</a>
      <a href={lang === 'en' ? '/about' : '/es/about'} class="btn-ghost">{lang === 'en' ? 'Our story' : 'Nuestra historia'}</a>
      <a href={lang === 'en' ? '/faq' : '/es/faq'} class="btn-ghost">{lang === 'en' ? 'Common questions' : 'Preguntas frecuentes'}</a>
    </div>
  </section>
</BaseLayout>
<script>
  const controls = document.querySelector<HTMLElement>('[data-catalog-controls]');
  const search = document.querySelector<HTMLInputElement>('[data-catalog-search]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-catalog-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-app-group]');
  const count = document.querySelector<HTMLElement>('[data-catalog-count]');
  const empty = document.querySelector<HTMLElement>('[data-catalog-empty]');
  const normalize = (value: string) => value.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
  let group = 'all';
  const filter = () => {
    const query = normalize(search?.value.trim() ?? '');
    let visible = 0;
    cards.forEach((card) => {
      const matches = (group === 'all' || card.dataset.appGroup === group) && normalize(card.dataset.appSearch ?? '').includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    if (count) count.textContent = (count.dataset.label ?? '{count}').replace('{count}', String(visible));
    if (empty) empty.hidden = visible > 0;
  };
  buttons.forEach((button) => button.addEventListener('click', () => {
    group = button.dataset.catalogFilter ?? 'all';
    buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
    filter();
  }));
  search?.addEventListener('input', filter);
  if (controls) controls.hidden = false;
</script>
<style>
  .landing-hero { background: radial-gradient(ellipse at 25% 20%, #00f2ff0d, transparent 65%), radial-gradient(ellipse at 80% 60%, #7a5cff16, transparent 65%); }
  [data-catalog-filter][aria-pressed="true"] { border-color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 9%, var(--color-base-100)); color: var(--color-accent); }
  .trust-icon { display: inline-flex; flex-shrink: 0; color: var(--color-accent); }
  .trust-icon :global(svg) { width: 1rem; height: 1rem; }
  .hero-stage { position: relative; height: 170px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, black 12%, black 88%, transparent); }
  .hero-horizon { position: absolute; top: 74px; left: 50%; width: 1000px; height: 600px; transform: translateX(-50%); border-radius: 50%; border: 1px solid #00f2ff77; background: radial-gradient(ellipse at 50% 0%, #1d3150, #101426 45%, #0d0f17 70%); box-shadow: 0 -12px 60px -12px #00f2ff55; }
  .hero-core { position: absolute; top: 115px; left: calc(50% - 24px); }
  .hero-orbit { position: absolute; top: 455px; left: 50%; }
  .hero-node { position: absolute; transform: rotate(var(--angle)) translateY(-420px) rotate(calc(-1 * var(--angle))); }
  .hero-node-icon { display: grid; place-items: center; width: 60px; height: 60px; margin: -30px; border: 1px solid #ffffff24; border-radius: 50%; background: #101420; box-shadow: 0 4px 20px #0007; }
  .hero-node-icon img { width: 40px; height: 40px; object-fit: contain; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-orbit { animation: orbit 72s linear infinite; }
    .hero-node-icon { animation: orbit 72s linear infinite reverse; }
  }
  @keyframes orbit { to { rotate: 360deg; } }
</style>
