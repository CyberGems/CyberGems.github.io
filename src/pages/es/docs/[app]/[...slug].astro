---
import DocsPage from '../../../../components/DocsPage.astro';
import { listDocs } from '../../../../data/docs';
export function getStaticPaths() {
  return listDocs().map((doc) => ({
    params: { app: doc.appDir.toLowerCase(), slug: doc.slug || undefined },
    props: { doc },
  }));
}
const { doc } = Astro.props;
---
<DocsPage doc={doc} lang="es" />
